    "NSCameraUsageDescription" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그 자리의 사진을 남기고, 찍은 것을 오려 지도에 얹을 스티커로 만들기 위해 카메라를 사용합니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses the camera to save a photo of the spot and turn what you capture into a sticker for your map."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses the camera to save a photo of the spot and turn what you capture into a sticker for your map."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その場所の写真を残し、撮ったものを切り抜いて地図に載せるステッカーにするため、カメラを使用します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于拍下当地的照片，并把拍到的物体抠出来，做成可放在地图上的贴纸，因此需要使用相机。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於拍下當地的照片，並把拍到的物體去背，製作可放在地圖上的貼圖，因此需要使用相機。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa la cámara para guardar una foto del lugar y recortar lo que fotografíes para convertirlo en una pegatina para el mapa."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kamera wird genutzt, um ein Foto vom Ort zu sichern und das Fotografierte als Sticker für deine Karte freizustellen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’appareil photo sert à garder une photo du lieu et à détourer ce que vous photographiez pour en faire un sticker à poser sur la carte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa la fotocamera per conservare una foto del luogo e ritagliare ciò che fotografi, così da farne un adesivo da mettere sulla mappa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa a câmera para guardar uma foto do lugar e recortar o que você fotografar, transformando em um adesivo para colocar no mapa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Камера нужна, чтобы сохранить фото места и вырезать снятое в стикер, который можно поставить на карту."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้กล้องเพื่อบันทึกรูปของสถานที่ และตัดสิ่งที่ถ่ายออกมาทำเป็นสติกเกอร์วางบนแผนที่"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng máy ảnh để lưu ảnh nơi đó và cắt vật bạn chụp thành nhãn dán đặt lên bản đồ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotoaparát slouží k uložení fotky místa a k vystřižení vyfoceného předmětu do nálepky, kterou položíš na mapu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kameraet bruges til at gemme et foto af stedet og til at frilægge det, du fotograferer, som et klistermærke til kortet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η κάμερα χρησιμοποιείται για να κρατήσετε φωτογραφία του μέρους και να αποκόψετε ό,τι φωτογραφίζετε σε αυτοκόλλητο για τον χάρτη."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kameralla tallennetaan kuva paikasta ja leikataan kuvaamasi kohde tarraksi, jonka voi asettaa kartalle."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera dipakai untuk menyimpan foto tempat dan memotong benda yang kamu foto menjadi stiker untuk ditaruh di peta."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kameraet brukes til å arkivere et bilde av stedet og klippe ut det du fotograferer som et klistremerke til kartet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De camera wordt gebruikt om een foto van de plek te bewaren en het gefotografeerde uit te knippen als sticker voor op de kaart."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparat służy do zapisania zdjęcia miejsca i wycięcia fotografowanego obiektu w naklejkę, którą można postawić na mapie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kameran används för att spara ett foto av platsen och klippa ut det du fotograferar till ett klistermärke som kan läggas på kartan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera, yerin fotoğrafını kaydetmek ve çektiğin nesneyi haritaya koyabileceğin bir çıkartmaya dönüştürmek için kullanılır."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장소를 옮길 때마다 발자국을 자동으로 기록하려면 '항상 허용' 권한이 필요합니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Always\" permission is needed to automatically record your footprints whenever you move between places."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Always\" permission is needed to automatically record your footprints whenever you move between places."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "場所を移動するたびに足あとを自動で記録するには、「常に許可」の権限が必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要在你每次换地方时自动记录足迹，需要“始终允许”的权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要在你每次換地方時自動記錄足跡，需要「永遠允許」的權限。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para registrar tus huellas automáticamente cada vez que cambias de lugar, se necesita el permiso «Siempre»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um deine Fußspuren bei jedem Ortswechsel automatisch aufzuzeichnen, ist die Berechtigung „Immer“ nötig."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour enregistrer automatiquement vos empreintes à chaque changement de lieu, l’autorisation « Toujours » est nécessaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per registrare automaticamente le tue impronte a ogni cambio di luogo serve il permesso «Sempre»."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para registrar suas pegadas automaticamente a cada mudança de lugar, é preciso a permissão «Sempre»."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы автоматически записывать следы при каждой смене места, нужно разрешение «Всегда»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต้องใช้สิทธิ์ \"เสมอ\" เพื่อบันทึกรอยเท้าอัตโนมัติทุกครั้งที่ย้ายสถานที่"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cần quyền \"Luôn luôn\" để tự động ghi dấu chân mỗi khi bạn đổi chỗ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "K automatickému zaznamenávání stop při každé změně místa je potřeba oprávnění „Vždy“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilladelsen „Altid“ er nødvendig for automatisk at registrere dine fodspor, hver gang du skifter sted."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για να καταγράφονται αυτόματα τα αποτυπώματα σε κάθε αλλαγή μέρους, χρειάζεται η άδεια «Πάντα»."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Aina”-lupa tarvitaan, jotta jalanjälkesi tallentuvat automaattisesti aina paikkaa vaihtaessasi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izin \"Selalu\" diperlukan untuk mencatat jejak kakimu secara otomatis setiap kali berpindah tempat."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillatelsen «Alltid» trengs for å registrere fotsporene dine automatisk hver gang du skifter sted."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De toestemming ‘Altijd’ is nodig om je voetafdrukken automatisch vast te leggen telkens als je van plek wisselt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uprawnienie „Zawsze” jest potrzebne, aby automatycznie zapisywać ślady przy każdej zmianie miejsca."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behörigheten ”Alltid” behövs för att automatiskt logga dina fotspår varje gång du byter plats."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yer değiştirdiğinde ayak izlerini otomatik kaydetmek için “Her Zaman” izni gerekir."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 위치를 지도에 발자국으로 기록하기 위해 위치 권한이 필요합니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location permission is needed to record your current position as a footprint on the map."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location permission is needed to record your current position as a footprint on the map."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在地を足あととして地図に記録するために、位置情報の権限が必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要定位权限，才能把你当前的位置作为足迹记录到地图上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要定位權限，才能把你目前的位置作為足跡記錄到地圖上。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesita el permiso de ubicación para registrar tu posición actual como una huella en el mapa."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Standortzugriff wird benötigt, um deinen aktuellen Standort als Fußspur auf der Karte aufzuzeichnen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’autorisation de localisation est nécessaire pour enregistrer votre position actuelle comme empreinte sur la carte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serve il permesso di posizione per registrare la tua posizione attuale come impronta sulla mappa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A permissão de localização é necessária para registrar sua posição atual como pegada no mapa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешение на геопозицию нужно, чтобы записывать ваше текущее положение на карту как след."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต้องใช้สิทธิ์ตำแหน่งเพื่อบันทึกตำแหน่งปัจจุบันเป็นรอยเท้าบนแผนที่"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cần quyền vị trí để ghi vị trí hiện tại của bạn thành dấu chân trên bản đồ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oprávnění k poloze je potřeba, aby se tvá aktuální poloha zaznamenala jako stopa na mapě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokalitetstilladelse er nødvendig for at registrere din nuværende position som et fodspor på kortet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρειάζεται η άδεια τοποθεσίας για να καταγράφεται η τρέχουσα θέση σας ως αποτύπωμα στον χάρτη."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sijaintilupa tarvitaan, jotta nykyinen sijaintisi voidaan tallentaa jalanjäljeksi karttaan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izin lokasi diperlukan untuk mencatat posisimu saat ini sebagai jejak kaki di peta."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posisjonstillatelse trengs for å registrere din nåværende posisjon som et fotspor på kartet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locatietoestemming is nodig om je huidige positie als voetafdruk op de kaart vast te leggen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uprawnienie do lokalizacji jest potrzebne, aby zapisać Twoją obecną pozycję jako ślad na mapie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platsbehörighet behövs för att logga din nuvarande position som ett fotspår på kartan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şu anki konumunu haritaya ayak izi olarak kaydetmek için konum izni gerekir."
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "걷기·뛰기로 이동했는지 확인해 차량 이동은 기록하지 않기 위해 동작 데이터를 사용합니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses motion data to tell whether you moved on foot or by running, so travel by vehicle isn't recorded."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses motion data to tell whether you moved on foot or by running, so travel by vehicle isn't recorded."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "徒歩やランニングで移動したかを確認し、乗り物での移動を記録しないために、モーションデータを使用します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用运动数据来确认你是步行或跑步移动，以免记录乘车的移动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
