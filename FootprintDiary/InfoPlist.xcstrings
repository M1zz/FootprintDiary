        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "벅뚜벅뚜"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그 자리의 사진을 남기고, 찍은 것을 오려 지도에 얹을 스티커로 만들기 위해 카메라를 사용합니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses the camera to save a photo of the spot and turn what you capture into a sticker for your map."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses the camera to save a photo of the spot and turn what you capture into a sticker for your map."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その場所の写真を残し、撮ったものを切り抜いて地図に載せるステッカーにするため、カメラを使用します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于拍下当地的照片，并把拍到的物体抠出来，做成可放在地图上的贴纸，因此需要使用相机。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於拍下當地的照片，並把拍到的物體去背，製作可放在地圖上的貼圖，因此需要使用相機。"
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장소를 옮길 때마다 발자국을 자동으로 기록하려면 '항상 허용' 권한이 필요합니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Always\" permission is needed to automatically record your footprints whenever you move between places."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Always\" permission is needed to automatically record your footprints whenever you move between places."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "場所を移動するたびに足あとを自動で記録するには、「常に許可」の権限が必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要在你每次换地方时自动记录足迹，需要“始终允许”的权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要在你每次換地方時自動記錄足跡，需要「永遠允許」的權限。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 위치를 지도에 발자국으로 기록하기 위해 위치 권한이 필요합니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location permission is needed to record your current position as a footprint on the map."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location permission is needed to record your current position as a footprint on the map."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在地を足あととして地図に記録するために、位置情報の権限が必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要定位权限，才能把你当前的位置作为足迹记录到地图上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要定位權限，才能把你目前的位置作為足跡記錄到地圖上。"
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "걷기·뛰기로 이동했는지 확인해 차량 이동은 기록하지 않기 위해 동작 데이터를 사용합니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses motion data to tell whether you moved on foot or by running, so travel by vehicle isn't recorded."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses motion data to tell whether you moved on foot or by running, so travel by vehicle isn't recorded."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "徒歩やランニングで移動したかを確認し、乗り物での移動を記録しないために、モーションデータを使用します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用运动数据来确认你是步行或跑步移动，以免记录乘车的移动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用動作資料來確認你是步行或跑步移動，以免記錄搭乘交通工具的移動。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
