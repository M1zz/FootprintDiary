{
  "sourceLanguage" : "ko",
  "strings" : {
    "CFBundleDisplayName" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "벅뚜벅뚜"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "벅뚜벅뚜"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그 자리의 사진을 남기고, 찍은 것을 오려 지도에 얹을 스티커로 만들기 위해 카메라를 사용합니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses the camera to save a photo of the spot and turn what you capture into a sticker for your map."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장소를 옮길 때마다 발자국을 자동으로 기록하려면 '항상 허용' 권한이 필요합니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Always\" permission is needed to automatically record your footprints whenever you move between places."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 위치를 지도에 발자국으로 기록하기 위해 위치 권한이 필요합니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location permission is needed to record your current position as a footprint on the map."
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "걷기·뛰기로 이동했는지 확인해 차량 이동은 기록하지 않기 위해 동작 데이터를 사용합니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses motion data to tell whether you moved on foot or by running, so travel by vehicle isn't recorded."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
