    "여기서 %@ 떨어져 있어요. %lldm 안에 들어가면 가본 곳이 됩니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je to odsud %@. Až budeš do %lld m, stane se z toho navštívené místo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ herfra. Inden for %lld m bliver det et besøgt sted."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist %@ entfernt. Komm auf %lld m heran, dann wird es zum besuchten Ort."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απέχει %@ από εδώ. Μόλις μπείτε σε ακτίνα %lld μ., γίνεται επισκέψιμο μέρος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're %@ away. Come within %lld m to make it a visited place."
          }
