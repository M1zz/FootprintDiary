    "걸음 수로 걷기를 알아채서 산책 앞부분을 놓치지 않아요" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozná chůzi podle kroků, takže nepřijdeš o začátek procházky"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genkender gang ud fra skridt, så starten af turen ikke går tabt"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkennt das Gehen an deinen Schritten, damit der Anfang nicht verloren geht"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναγνωρίζει το περπάτημα από τα βήματα, ώστε να μη χάνεται η αρχή της βόλτας"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detects walking from your steps, so the start of a walk isn't missed"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detects walking from your steps, so the start of a walk isn't missed"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detecta que caminas por los pasos para no perder el inicio del paseo"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunnistaa kävelyn askelista, joten kävelyn alku ei jää pois"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Détecte la marche grâce aux pas pour ne pas manquer le début de la balade"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengenali jalan kaki dari jumlah langkah, jadi awal jalan-jalanmu tidak terlewat"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riconosce la camminata dai passi per non perdere l’inizio della passeggiata"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歩数で歩き始めを察知するので、散歩の最初を逃しません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "걸음 수로 걷기를 알아채서 산책 앞부분을 놓치지 않아요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjenkjenner gåing ut fra skritt, så starten av turen ikke går tapt"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herkent wandelen aan je stappen, zodat het begin van je wandeling niet verloren gaat"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpoznaje chód po krokach i nie gubi początku spaceru"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detecta a caminhada pelos passos e não perde o começo do passeio"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Распознаёт ходьбу по шагам и не пропускает начало прогулки"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Känner igen promenader på stegen, så att början inte missas"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รู้ว่ากำลังเดินจากจำนวนก้าว จึงไม่พลาดช่วงแรกของการเดินเล่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yürüyüşü adımlardan fark eder, yürüyüşün başını kaçırmaz"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhận biết việc đi bộ qua số bước nên không bỏ lỡ đoạn đầu của buổi dạo"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过步数察觉你开始步行，不会漏掉散步的开头"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過步數察覺你開始步行，不會漏掉散步的開頭"
          }
        }
      }
    },
    "걸음·스탬프·일기가 내 아이클라우드에 함께 저장됩니다. 기기를 바꿔도 그대로 따라와요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kroky, razítka i deník se ukládají společně do tvého iCloudu. Zůstanou ti i při změně zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gåture, stempler og dagbog gemmes i din iCloud. De følger med, også hvis du skifter enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wege, Stempel und Tagebuch werden zusammen in deiner iCloud gespeichert. Sie kommen mit, wenn du das Gerät wechselst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα βήματα, οι σφραγίδες και το ημερολόγιο αποθηκεύονται μαζί στο iCloud σας. Σας ακολουθούν και αν αλλάξετε συσκευή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your walks, stamps and diary are saved together in your iCloud. They come with you when you switch devices."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your walks, stamps and diary are saved together in your iCloud. They come with you when you switch devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus pasos, sellos y diario se guardan juntos en tu iCloud. Te siguen aunque cambies de dispositivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kävelyt, leimat ja päiväkirja tallentuvat iCloudiisi. Ne seuraavat mukana, vaikka vaihtaisit laitetta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos pas, tampons et journal sont enregistrés ensemble dans votre iCloud. Ils vous suivent même si vous changez d’appareil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langkah, stempel, dan catatan harian tersimpan bersama di iCloud-mu. Ganti perangkat pun tetap ikut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passi, timbri e diario vengono salvati insieme nel tuo iCloud. Ti seguono anche se cambi dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歩行・スタンプ・日記があなたのiCloudにまとめて保存されます。機種変更してもそのまま引き継がれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "걸음·스탬프·일기가 내 아이클라우드에 함께 저장됩니다. 기기를 바꿔도 그대로 따라와요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turer, stempler og dagbok lagres i din iCloud. De følger med selv om du bytter enhet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stappen, stempels en dagboek worden samen in je iCloud bewaard. Ook op een nieuw apparaat zijn ze er gewoon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spacery, pieczątki i dziennik są zapisywane razem w Twoim iCloud. Po zmianie urządzenia wszystko przejdzie z Tobą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caminhadas, carimbos e diário são salvos juntos no seu iCloud. Se trocar de aparelho, tudo vem junto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прогулки, штампы и дневник хранятся вместе в вашем iCloud. Если смените устройство, всё перейдёт на него."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steg, stämplar och dagbok sparas tillsammans i din iCloud. Byter du enhet följer de med."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเดิน ตราประทับ และไดอารี่จะถูกบันทึกไว้ใน iCloud ของคุณด้วยกัน เปลี่ยนเครื่องก็ตามไปด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adımların, damgaların ve günlüğün birlikte iCloud'una kaydedilir. Cihaz değiştirsen de seninle gelir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bước đi, con dấu và nhật ký được lưu cùng nhau trong iCloud của bạn. Đổi máy vẫn còn nguyên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "步行、图章和日记会一起保存在你的 iCloud 中。换了设备也会跟着过来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "步行、印章和日記會一起儲存在你的 iCloud 中。換了裝置也會跟著過來。"
          }
        }
      }
    },
