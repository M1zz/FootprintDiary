    "어느 쪽이든 받은 위치는 모두 저장합니다. 정확도가 낮은 점은 지도에 그리지 않을 뿐이에요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어느 쪽이든 받은 위치는 모두 저장합니다. 정확도가 낮은 점은 지도에 그리지 않을 뿐이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Either way, every location received is saved. Low-accuracy points just aren't drawn on the map."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Either way, every location received is saved. Low-accuracy points just aren't drawn on the map."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どちらを選んでも、受け取った位置情報はすべて保存します。精度の低いポイントを地図に描かないだけです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无论选哪一种，收到的位置都会全部保存。只是精度较低的点位不会绘制到地图上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無論選哪一種，收到的位置都會全部儲存。只是精準度較低的點位不會繪製到地圖上。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En cualquier caso, se guardan todas las ubicaciones recibidas. Solo que los puntos poco precisos no se dibujan en el mapa."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So oder so werden alle empfangenen Standorte gespeichert. Nur Punkte mit geringer Genauigkeit werden nicht auf der Karte gezeichnet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans les deux cas, toutes les positions reçues sont enregistrées. Seuls les points peu précis ne sont pas dessinés sur la carte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In ogni caso, tutte le posizioni ricevute vengono salvate. Solo i punti poco precisi non vengono disegnati sulla mappa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em qualquer caso, todas as posições recebidas são salvas. Só os pontos pouco precisos não são desenhados no mapa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В любом случае все полученные координаты сохраняются. Просто неточные точки не рисуются на карте."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่ว่าจะเลือกแบบไหน ตำแหน่งที่ได้รับมาทั้งหมดจะถูกบันทึกไว้ เพียงแต่จุดที่แม่นยำต่ำจะไม่ถูกวาดบนแผนที่"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dù chọn cách nào, mọi vị trí nhận được đều được lưu. Chỉ là các điểm kém chính xác sẽ không được vẽ lên bản đồ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tak či tak se ukládají všechny přijaté polohy. Jen body s nízkou přesností se do mapy nekreslí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uanset hvad gemmes alle modtagne positioner. Det er bare punkter med lav nøjagtighed, der ikke tegnes på kortet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε κάθε περίπτωση αποθηκεύονται όλες οι τοποθεσίες που λαμβάνονται. Απλώς τα σημεία χαμηλής ακρίβειας δεν σχεδιάζονται στον χάρτη."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kummin tahansa kaikki vastaanotetut sijainnit tallennetaan. Vain heikon tarkkuuden pisteitä ei piirretä karttaan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apa pun pilihannya, semua lokasi yang diterima tetap disimpan. Hanya titik dengan akurasi rendah yang tidak digambar di peta."
          }
        }
      }
    },
    "어떤 화면이 쓰이는지 익명으로만 셉니다. 걸은 자리와 일기 글은 보내지 않아요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어떤 화면이 쓰이는지 익명으로만 셉니다. 걸은 자리와 일기 글은 보내지 않아요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We only count which screens are used, anonymously. Where you walked and your diary entries are never sent."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We only count which screens are used, anonymously. Where you walked and your diary entries are never sent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どの画面が使われたかを匿名で数えるだけです。歩いた場所や日記の文章は送信しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅以匿名方式统计哪些页面被使用。不会发送你走过的地点和日记内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅以匿名方式統計哪些畫面被使用。不會傳送你走過的地點和日記內容。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se cuentan, de forma anónima, las pantallas que se usan. No se envían los lugares que caminas ni el texto de tu diario."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird nur anonym gezählt, welche Bildschirme genutzt werden. Wo du gegangen bist und was du ins Tagebuch schreibst, wird nicht gesendet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls les écrans utilisés sont comptés, de façon anonyme. Les lieux où vous marchez et le texte de votre journal ne sont pas envoyés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si contano solo, in forma anonima, le schermate utilizzate. I luoghi in cui cammini e il testo del diario non vengono inviati."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só se conta, de forma anônima, quais telas são usadas. Os lugares por onde você anda e o texto do diário não são enviados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Анонимно считается только то, какие экраны используются. Места, где вы ходили, и записи дневника не отправляются."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นับเฉพาะว่ามีการใช้หน้าจอใดบ้างแบบไม่ระบุตัวตน ที่ที่คุณเดินและข้อความในไดอารี่จะไม่ถูกส่ง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ đếm ẩn danh xem màn hình nào được dùng. Nơi bạn đã đi và nội dung nhật ký sẽ không được gửi đi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonymně se počítá jen to, které obrazovky se používají. Kde chodíš a co píšeš do deníku, se neodesílá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der tælles kun anonymt, hvilke skærme der bruges. Hvor du går, og hvad du skriver i dagbogen, sendes ikke."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετριέται μόνο ανώνυμα ποιες οθόνες χρησιμοποιούνται. Τα μέρη που περπατάτε και το κείμενο του ημερολογίου δεν στέλνονται."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonyymisti lasketaan vain, mitä näkymiä käytetään. Kävelemiäsi paikkoja ja päiväkirjatekstejä ei lähetetä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya dihitung secara anonim layar mana yang dipakai. Tempat yang kamu lalui dan isi catatan harian tidak dikirim."
          }
        }
      }
    },
