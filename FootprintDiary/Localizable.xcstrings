    "VoiceOver가 지도와 기록의 단추와 내용을 빠짐없이, 알맞은 순서로 읽어 줘요." : {
      "comment" : "Roadmap item detail: better VoiceOver support",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver reads every button and detail on your map and records, in the right order."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver가 지도와 기록의 단추와 내용을 빠짐없이, 알맞은 순서로 읽어 줘요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver reads every button and detail on your map and records, in the right order."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOverが地図と記録のボタンや内容を、漏れなく適切な順序で読み上げます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver 会按合适的顺序，完整朗读地图和记录里的按钮与内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver 會依合適的順序，完整朗讀地圖和紀錄裡的按鈕與內容。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver lee todos los botones y detalles de tu mapa y tus registros, en el orden correcto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver liest alle Knöpfe und Inhalte deiner Karte und Aufzeichnungen vollständig und in der richtigen Reihenfolge vor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver lit tous les boutons et détails de votre carte et de vos enregistrements, dans le bon ordre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver legge tutti i pulsanti e i dettagli di mappa e registrazioni, nell’ordine giusto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O VoiceOver lê todos os botões e detalhes do seu mapa e dos registros, na ordem certa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver зачитывает все кнопки и подробности карты и записей без пропусков и в правильном порядке."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver อ่านปุ่มและเนื้อหาในแผนที่และบันทึกให้ครบถ้วนตามลำดับที่เหมาะสม"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver đọc đầy đủ mọi nút và nội dung của bản đồ và bản ghi, theo đúng thứ tự."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver přečte všechna tlačítka a podrobnosti mapy i záznamů, a to ve správném pořadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver læser alle knapper og detaljer på dit kort og dine registreringer op i den rigtige rækkefølge."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το VoiceOver διαβάζει όλα τα κουμπιά και τις λεπτομέρειες του χάρτη και των καταγραφών, με τη σωστή σειρά."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver lukee kartan ja tallenteiden kaikki painikkeet ja tiedot oikeassa järjestyksessä."
