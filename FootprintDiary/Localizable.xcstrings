    "세상은 이미 다른 지도가 다 그려 두었어요.\n여기에는 **당신이 두 발로 지난 자리만** 남습니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세상은 이미 다른 지도가 다 그려 두었어요.\n여기에는 **당신이 두 발로 지난 자리만** 남습니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Other maps have already drawn the whole world.\nHere, only **the places you've walked** remain."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Other maps have already drawn the whole world.\nHere, only **the places you've walked** remain."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "世界はもう、ほかの地図が描き終えています。\nここに残るのは、**あなたが自分の足で通った場所だけ**です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "世界早已被别的地图画满。\n而这里只留下**你亲脚走过的地方**。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "世界早已被別的地圖畫滿。\n而這裡只留下**你親腳走過的地方**。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los demás mapas ya dibujaron el mundo entero.\nAquí solo quedan **los lugares que pisaste con tus propios pies**."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Welt haben andere Karten längst gezeichnet.\nHier bleibt **nur, wo du mit deinen eigenen Füßen warst**."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le monde a déjà été dessiné par d’autres cartes.\nIci ne restent que **les lieux que vous avez foulés de vos propres pieds**."
          }
        }
      }
    },
