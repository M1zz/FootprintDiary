    "하루를 마칠 때 오늘 걸은 길을 알림으로 알려 줘요." : {
      "comment" : "Roadmap item detail: notifications",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At the end of the day, get a notification about the path you walked today."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루를 마칠 때 오늘 걸은 길을 알림으로 알려 줘요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At the end of the day, get a notification about the path you walked today."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1日の終わりに、今日歩いた道を通知でお知らせします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天结束时，用通知告诉你今天走过的路。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天結束時，用通知告訴你今天走過的路。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al terminar el día, te avisa con una notificación del camino que recorriste hoy."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am Ende des Tages erhältst du eine Mitteilung über den Weg, den du heute gegangen bist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En fin de journée, une notification vous rappelle le chemin parcouru aujourd’hui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fine giornata, una notifica ti ricorda il percorso fatto oggi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No fim do dia, uma notificação lembra o caminho que você fez hoje."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В конце дня уведомление расскажет, какой путь вы прошли сегодня."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อสิ้นสุดวัน จะแจ้งเตือนเส้นทางที่คุณเดินวันนี้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuối ngày, thông báo sẽ cho bạn biết con đường đã đi hôm nay."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na konci dne ti oznámení připomene cestu, kterou jsi dnes ušel."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dagen er slut, fortæller en notifikation dig om den vej, du gik i dag."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στο τέλος της ημέρας, μια ειδοποίηση σας λέει τη διαδρομή που περπατήσατε σήμερα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päivän päätteeksi ilmoitus kertoo tänään kulkemasi reitin."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di akhir hari, notifikasi memberi tahu jalan yang kamu lalui hari ini."
          }
        }
      }
    },
    "한 곳에 %lld분 넘게 머물면\n그 자리가 오늘의 발자취에 섭니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 곳에 %lld분 넘게 머물면\n그 자리가 오늘의 발자취에 섭니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you stay in one place for over %lld minutes,\nit's added to today's footprints."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you stay in one place for over %lld minutes,\nit's added to today's footprints."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1か所に%lld分以上とどまると、\nその場所が今日の足あとに並びます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在同一处停留超过%lld分钟，\n这个地方就会出现在今日足迹中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在同一處停留超過%lld分鐘，\n這個地方就會出現在今日足跡中。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si te quedas más de %lld minutos en un mismo sitio,\neste aparecerá en las huellas de hoy."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleibst du länger als %lld Minuten an einem Ort,\nerscheint er in den heutigen Fußspuren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous restez plus de %lld minutes au même endroit,\nil apparaît dans les empreintes du jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se resti più di %lld minuti nello stesso posto,\nquesto compare nelle impronte di oggi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você ficar mais de %lld minutos no mesmo lugar,\nele aparece nas pegadas de hoje."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если вы пробудете на одном месте больше %lld мин.,\nэто место появится в сегодняшних следах."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากอยู่ที่เดิมนานเกิน %lld นาที\nที่นั่นจะปรากฏในรอยเท้าวันนี้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu bạn ở một chỗ quá %lld phút,\nchỗ đó sẽ hiện trong dấu chân hôm nay."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když se na jednom místě zdržíš déle než %lld minut,\nobjeví se v dnešních stopách."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du bliver mere end %lld minutter det samme sted,\nvises stedet i dagens fodspor."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν μείνετε πάνω από %lld λεπτά σε ένα μέρος,\nθα εμφανιστεί στα σημερινά αποτυπώματα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos viivyt samassa paikassa yli %lld minuuttia,\npaikka ilmestyy päivän jalanjälkiin."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika kamu berada di satu tempat lebih dari %lld menit,\ntempat itu muncul di jejak kaki hari ini."
          }
        }
      }
    },
