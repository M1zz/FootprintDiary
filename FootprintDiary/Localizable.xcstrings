    "카메라로 찍어 이 자리만의 심볼을 만들 수 있어요. 지도에 그 그림이 찍힙니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyfoť si vlastní symbol pro tohle místo. Na mapu se otiskne ten obrázek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tag et billede med kameraet for at lave et symbol kun for dette sted. Det vises på kortet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach ein Foto, um ein eigenes Symbol für diesen Ort zu erstellen. Dieses Bild erscheint dann auf der Karte."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τραβήξτε φωτογραφία για να φτιάξετε ένα δικό σας σύμβολο για αυτό το μέρος. Θα μπει στον χάρτη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take a photo to make a symbol just for this spot. That picture is what appears on the map."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take a photo to make a symbol just for this spot. That picture is what appears on the map."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz una foto para crear un símbolo propio de este lugar. Esa imagen se pondrá en el mapa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota kuva kameralla ja tee tälle paikalle oma symboli. Se näkyy kartalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prenez une photo pour créer un symbole propre à ce lieu. C’est cette image qui sera tamponnée sur la carte."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto dengan kamera untuk membuat simbol khusus tempat ini. Gambar itu akan dicap di peta."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scatta una foto per creare un simbolo tutto per questo luogo. Sarà quell’immagine a comparire sulla mappa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラで撮って、この場所だけのシンボルを作れます。地図にはその絵が押されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카메라로 찍어 이 자리만의 심볼을 만들 수 있어요. 지도에 그 그림이 찍힙니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta et bilde med kameraet for å lage et eget symbol for dette stedet. Det vises på kartet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak met de camera een eigen symbool voor deze plek. Die afbeelding komt op de kaart."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zrób zdjęcie, aby stworzyć symbol tylko dla tego miejsca. Ten obraz pojawi się na mapie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tire uma foto para criar um símbolo só deste lugar. É essa imagem que aparece no mapa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сфотографируйте, чтобы создать символ только для этого места. Этот рисунок появится на карте."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fota med kameran för att skapa en egen symbol för just den här platsen. Bilden stämplas på kartan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ่ายด้วยกล้องเพื่อสร้างสัญลักษณ์เฉพาะของที่นี่ได้ ภาพนั้นจะถูกประทับบนแผนที่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
