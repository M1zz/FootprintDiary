    "이 나침반은 지금까지 걸으신 자리로 그립니다.\n조금 걸으신 뒤에 다시 열어 보세요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento kompas se kreslí z míst, kudy jsi zatím chodil.\nOtevři ho znovu, až se trochu projdeš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompasset tegnes ud fra de steder, du har gået indtil nu.\nGå en lille tur, og åbn det så igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Kompass entsteht aus deinen bisherigen Wegen.\nGeh ein Stück und öffne ihn dann erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η πυξίδα σχεδιάζεται από τα μέρη που έχετε περπατήσει.\nΑνοίξτε την ξανά αφού περπατήσετε λίγο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This compass is drawn from where you've walked so far.\nWalk a little, then open it again."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This compass is drawn from where you've walked so far.\nWalk a little, then open it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta brújula se dibuja con los lugares que has caminado.\nCamina un poco y vuelve a abrirla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompassi piirretään tähän mennessä kulkemiesi paikkojen perusteella.\nKävele hetki ja avaa se sitten uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette boussole se dessine à partir des lieux où vous avez marché.\nMarchez un peu, puis rouvrez-la."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompas ini digambar dari tempat yang sudah kamu lalui.\nBerjalanlah sebentar, lalu buka lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa bussola si disegna con i luoghi in cui hai camminato.\nCammina un po’ e poi riaprila."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このコンパスは、これまで歩いた場所をもとに描きます。\n少し歩いてから、もう一度開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 나침반은 지금까지 걸으신 자리로 그립니다.\n조금 걸으신 뒤에 다시 열어 보세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompasset tegnes ut fra stedene du har gått så langt.\nGå en liten tur, og åpne det igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit kompas wordt getekend op basis van waar je tot nu toe liep.\nLoop even en open het dan opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten kompas powstaje z miejsc, w których już chodziłeś.\nPrzejdź się trochę i otwórz go ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta bússola é desenhada com os lugares por onde você já andou.\nCaminhe um pouco e abra de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Компас строится по местам, где вы уже ходили.\nПрогуляйтесь немного и откройте снова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här kompassen ritas utifrån platser du gått hittills.\nGå en stund och öppna den sedan igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เข็มทิศนี้วาดจากที่ที่คุณเดินมาจนถึงตอนนี้\nลองเดินสักหน่อยแล้วเปิดใหม่อีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu pusula şimdiye kadar yürüdüğün yerlerle çizilir.\nBiraz yürüdükten sonra yeniden aç."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La bàn này được vẽ từ những nơi bạn đã đi cho đến nay.\nHãy đi bộ một chút rồi mở lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个罗盘根据你至今走过的地方来绘制。\n请走一走之后再打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個羅盤根據你至今走過的地方來繪製。\n請走一走之後再開啟。"
          }
        }
      }
    },
