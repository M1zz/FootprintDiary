        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ päässä täältä. %lld metrin sisällä voit merkitä käynnin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes à %@. À moins de %lld m, vous pourrez enregistrer votre visite."
