          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν περπατήσατε αλλά δεν σχεδιάστηκε γραμμή στον χάρτη, εδώ μπορείτε να δείτε τον λόγο."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
