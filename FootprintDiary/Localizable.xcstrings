          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その方面にはまだ一歩も出かけていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그쪽으로는 아직 한 걸음도 나가 보지 않으셨어요."
          }
        },
        "nb" : {
          "stringUnit" : {
