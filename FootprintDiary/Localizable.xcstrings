    "지도에 띄워 둘 단추를 고르고, 꺼 둔 화면도 설정에서 바로 열 수 있어요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지도에 띄워 둘 단추를 고르고, 꺼 둔 화면도 설정에서 바로 열 수 있어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick which buttons float on the map, and open screens you've turned off right from Settings."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick which buttons float on the map, and open screens you've turned off right from Settings."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地図に出すボタンを選べます。オフにした画面も設定からすぐ開けます。"
