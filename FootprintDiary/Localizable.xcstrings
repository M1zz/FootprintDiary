    "왼쪽 아래 **도장**을 누르면 지금 선 자리가 남아요" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepnutím na **Razítko** vlevo dole zaznamenáš místo, kde stojíš"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på **stemplet** nederst til venstre for at gemme, hvor du står"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe unten links auf den **Stempel**, um deinen Standort festzuhalten"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε τη **Σφραγίδα** κάτω αριστερά για να καταγραφεί το σημείο όπου βρίσκεστε"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the **stamp** at the bottom left to mark where you're standing"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the **stamp** at the bottom left to mark where you're standing"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el **sello** de abajo a la izquierda para marcar donde estás"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta vasemmalla alhaalla olevaa **leimaa**, niin nykyinen paikkasi tallentuu"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez le **tampon** en bas à gauche pour marquer l’endroit où vous êtes"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk **stempel** di kiri bawah untuk menyimpan tempatmu berdiri sekarang"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca il **timbro** in basso a sinistra per segnare dove sei"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左下の**スタンプ**をタップすると、今いる場所が残ります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "왼쪽 아래 **도장**을 누르면 지금 선 자리가 남아요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på **stempelet** nede til venstre for å lagre der du står"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik linksonder op de **stempel** om je huidige plek vast te leggen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotknij **pieczątki** w lewym dolnym rogu, aby zapisać miejsce, w którym stoisz"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque no **carimbo** no canto inferior esquerdo para marcar onde você está"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите **штамп** внизу слева, чтобы отметить, где вы стоите"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på **stämpeln** nere till vänster för att spara platsen där du står"
