    "아이클라우드를 붙이지 못해 기기 안에만 열었어요. 기록은 그대로 남아 있고, 다음에 켤 때 다시 시도합니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepodařilo se připojit iCloud, proto se aplikace otevřela jen v zařízení. Záznamy zůstávají a při dalším spuštění to zkusíme znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud kunne ikke tilsluttes, så dataene blev kun åbnet på denne enhed. Dine registreringer er i behold, og vi prøver igen næste gang, du åbner appen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud konnte nicht verbunden werden, daher wurde nur auf diesem Gerät geöffnet. Deine Aufzeichnungen sind erhalten; beim nächsten Start wird es erneut versucht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η σύνδεση με το iCloud, οπότε άνοιξε μόνο στη συσκευή. Οι καταγραφές σας παραμένουν και θα γίνει νέα προσπάθεια στο επόμενο άνοιγμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't connect to iCloud, so the app opened on this device only. Your records are intact, and it will try again the next time you open the app."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't connect to iCloud, so the app opened on this device only. Your records are intact, and it will try again the next time you open the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo conectar con iCloud y se abrió solo en este dispositivo. Tus registros siguen intactos; se volverá a intentar la próxima vez."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudiin ei saatu yhteyttä, joten tiedot avattiin vain tällä laitteella. Tallenteesi ovat tallessa, ja yritämme uudelleen seuraavalla avauskerralla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de se connecter à iCloud : l’app s’est ouverte sur cet appareil uniquement. Vos enregistrements sont intacts ; nouvelle tentative au prochain lancement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak bisa menyambung ke iCloud, jadi hanya dibuka di perangkat. Catatan tetap utuh dan akan dicoba lagi saat dibuka berikutnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile collegarsi a iCloud, quindi l’app si è aperta solo su questo dispositivo. Le registrazioni restano intatte; riproverà al prossimo avvio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudに接続できなかったため、この端末内だけで開きました。記録はそのまま残っており、次回起動時に再試行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아이클라우드를 붙이지 못해 기기 안에만 열었어요. 기록은 그대로 남아 있고, 다음에 켤 때 다시 시도합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke koble til iCloud, så dataene ble bare åpnet på denne enheten. Registreringene dine er i behold, og vi prøver igjen neste gang du åpner appen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kon geen verbinding maken met iCloud, dus de app is alleen op dit apparaat geopend. Je registraties blijven bewaard; de volgende keer wordt het opnieuw geprobeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się połączyć z iCloud, więc dane otwarto tylko na tym urządzeniu. Zapisy są na miejscu, a przy następnym uruchomieniu spróbujemy ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível conectar ao iCloud, então abrimos só neste aparelho. Seus registros continuam aqui, e tentaremos de novo na próxima vez que abrir o app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось подключиться к iCloud, поэтому данные открыты только на этом устройстве. Записи на месте; при следующем запуске попробуем снова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att ansluta till iCloud, så appen öppnades bara på enheten. Loggarna finns kvar, och ett nytt försök görs nästa gång."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เชื่อมต่อ iCloud ไม่ได้จึงเปิดไว้ในเครื่องเท่านั้น บันทึกยังอยู่ครบ และจะลองใหม่เมื่อเปิดครั้งถัดไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud'a bağlanılamadığı için yalnızca bu cihazda açıldı. Kayıtların duruyor; bir sonraki açılışta yeniden denenecek."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không kết nối được iCloud nên chỉ mở trên thiết bị. Bản ghi vẫn còn nguyên và sẽ thử lại khi mở lần sau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接 iCloud，已仅在本机打开。记录仍完好保留，下次启动时会再试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法連接 iCloud，已僅在本機開啟。紀錄仍完好保留，下次啟動時會再試。"
          }
        }
      }
    },
