    "설정 앱에서 아이클라우드에 로그인하면 기록이 저장되기 시작해요. 그때까지 기록은 이 기기 안에만 남습니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když se v aplikaci Nastavení přihlásíš k iCloudu, záznamy se začnou ukládat. Do té doby zůstanou jen v tomto zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du logger ind på iCloud i appen Indstillinger, begynder dine registreringer at blive gemt. Indtil da bliver de kun på denne enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich in der Einstellungen-App bei iCloud an, dann werden deine Aufzeichnungen dort gespeichert. Bis dahin bleiben sie nur auf diesem Gerät."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνδεθείτε στο iCloud από τις Ρυθμίσεις για να αρχίσει η αποθήκευση. Ως τότε οι καταγραφές μένουν μόνο σε αυτή τη συσκευή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in to iCloud in the Settings app and your records will start being saved there. Until then, they stay on this device only."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in to iCloud in the Settings app and your records will start being saved there. Until then, they stay on this device only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión en iCloud en Ajustes para empezar a guardar. Hasta entonces, tus registros se quedan solo en este dispositivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun kirjaudut iCloudiin Asetukset-apissa, tallenteet alkavat tallentua sinne. Siihen asti ne jäävät vain tälle laitteelle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous à iCloud dans Réglages pour commencer à sauvegarder. D’ici là, vos enregistrements restent uniquement sur cet appareil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masuk ke iCloud di aplikasi Pengaturan agar catatan mulai disimpan. Sampai saat itu, catatan hanya tersimpan di perangkat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi a iCloud in Impostazioni per iniziare a salvare. Fino ad allora, le registrazioni restano solo su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定アプリでiCloudにサインインすると、記録の保存が始まります。それまで記録はこの端末内にのみ残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 앱에서 아이클라우드에 로그인하면 기록이 저장되기 시작해요. 그때까지 기록은 이 기기 안에만 남습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du logger på iCloud i Innstillinger-appen, begynner registreringene å bli lagret. Til da blir de bare på denne enheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log in bij iCloud in de app Instellingen, dan worden je registraties daar bewaard. Tot die tijd blijven ze alleen op dit apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaloguj się do iCloud w aplikacji Ustawienia, a zapisy zaczną być zachowywane. Do tego czasu zostają tylko na tym urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicie sessão no iCloud no app Ajustes para começar a salvar os registros. Até lá, eles ficam só neste aparelho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Войдите в iCloud в приложении «Настройки», и записи начнут сохраняться. До тех пор они хранятся только на этом устройстве."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logga in på iCloud i appen Inställningar så börjar loggarna sparas där. Tills dess sparas de bara på den här enheten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลงชื่อเข้าใช้ iCloud ในแอปการตั้งค่า แล้วบันทึกจะเริ่มถูกจัดเก็บ ระหว่างนั้นบันทึกจะเก็บไว้ในเครื่องนี้เท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlar uygulamasında iCloud'a giriş yaptığında kayıtların saklanmaya başlar. O zamana kadar kayıtlar yalnızca bu cihazda kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đăng nhập iCloud trong ứng dụng Cài đặt để bắt đầu lưu bản ghi. Trước đó, bản ghi chỉ được lưu trên thiết bị này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置”App 中登录 iCloud 后，就会开始保存记录。在此之前，记录只会保存在这台设备上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「設定」App 中登入 iCloud 後，就會開始儲存紀錄。在此之前，紀錄只會儲存在這台裝置上。"
          }
        }
      }
    },
