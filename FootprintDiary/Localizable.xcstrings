        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ päässä täältä. %lld metrin sisällä siitä tulee käyty paikka."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes à %@. À moins de %lld m, il devient un lieu visité."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berjarak %@ dari sini. Masuk dalam %lld m agar jadi tempat yang dikunjungi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei a %@ di distanza. Entro %lld m diventa un luogo visitato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここから%@離れています。%lldm以内に入ると行った場所になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "여기서 %1$@ 떨어져 있어요. %2$lldm 안에 들어가면 가본 곳이 됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
