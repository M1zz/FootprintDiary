    "기기 설정이 아이클라우드를 막고 있어요. 기록은 이 기기 안에만 남습니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavení zařízení blokuje iCloud. Záznamy zůstanou jen v tomto zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enhedens indstillinger blokerer iCloud. Dine registreringer bliver kun på denne enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Geräteeinstellungen blockieren iCloud. Deine Aufzeichnungen bleiben nur auf diesem Gerät."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ρυθμίσεις της συσκευής μπλοκάρουν το iCloud. Οι καταγραφές μένουν μόνο σε αυτή τη συσκευή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your device settings are blocking iCloud. Your records stay on this device only."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your device settings are blocking iCloud. Your records stay on this device only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ajustes del dispositivo bloquean iCloud. Tus registros se quedan solo en este dispositivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laitteen asetukset estävät iCloudin. Tallenteet jäävät vain tälle laitteelle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réglages de l’appareil bloquent iCloud. Vos enregistrements restent uniquement sur cet appareil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengaturan perangkat memblokir iCloud. Catatan hanya tersimpan di perangkat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le impostazioni del dispositivo bloccano iCloud. Le registrazioni restano solo su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "端末の設定でiCloudが制限されています。記録はこの端末内にのみ残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기 설정이 아이클라우드를 막고 있어요. 기록은 이 기기 안에만 남습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enhetsinnstillingene blokkerer iCloud. Registreringene blir bare på denne enheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
