    "걸었는데 지도에 선이 그어지지 않으면 여기서 까닭을 볼 수 있어요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud jsi šel, ale v mapě se nevykreslila čára, důvod najdeš tady."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du gik, men der ikke kom en streg på kortet, kan du se årsagen her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du gegangen bist, aber keine Linie auf der Karte erscheint, findest du hier den Grund."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν περπατήσατε αλλά δεν σχεδιάστηκε γραμμή στον χάρτη, εδώ μπορείτε να δείτε τον λόγο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you walked but no line was drawn on the map, you can find out why here."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you walked but no line was drawn on the map, you can find out why here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
