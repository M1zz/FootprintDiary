    "하루를 마칠 때 오늘 걸은 길을 알림으로 알려 줘요." : {
      "comment" : "Roadmap item detail: notifications",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na konci dne ti oznámení připomene cestu, kterou jsi dnes ušel."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dagen er slut, fortæller en notifikation dig om den vej, du gik i dag."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am Ende des Tages erhältst du eine Mitteilung über den Weg, den du heute gegangen bist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στο τέλος της ημέρας, μια ειδοποίηση σας λέει τη διαδρομή που περπατήσατε σήμερα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At the end of the day, get a notification about the path you walked today."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At the end of the day, get a notification about the path you walked today."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al terminar el día, te avisa con una notificación del camino que recorriste hoy."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päivän päätteeksi ilmoitus kertoo tänään kulkemasi reitin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En fin de journée, une notification vous rappelle le chemin parcouru aujourd’hui."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di akhir hari, notifikasi memberi tahu jalan yang kamu lalui hari ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fine giornata, una notifica ti ricorda il percorso fatto oggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1日の終わりに、今日歩いた道を通知でお知らせします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루를 마칠 때 오늘 걸은 길을 알림으로 알려 줘요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På slutten av dagen forteller et varsel deg om veien du gikk i dag."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aan het eind van de dag laat een melding je weten welke weg je vandaag liep."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pod koniec dnia powiadomienie przypomni drogę, którą dziś przeszedłeś."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No fim do dia, uma notificação lembra o caminho que você fez hoje."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В конце дня уведомление расскажет, какой путь вы прошли сегодня."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I slutet av dagen berättar en avisering vilken väg du gick i dag."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อสิ้นสุดวัน จะแจ้งเตือนเส้นทางที่คุณเดินวันนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günün sonunda bildirim, bugün yürüdüğün yolu hatırlatır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuối ngày, thông báo sẽ cho bạn biết con đường đã đi hôm nay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天结束时，用通知告诉你今天走过的路。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天結束時，用通知告訴你今天走過的路。"
          }
        }
      }
    },
    "하루에 한 번만 셉니다. 내일 다시 오면 또 남길 수 있어요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počítá se jen jednou denně. Když přijdeš zítra, můžeš to zaznamenat znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tælles kun én gang om dagen. Kommer du igen i morgen, kan du gemme igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird einmal pro Tag gezählt. Komm morgen wieder, um es erneut festzuhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετράει μία φορά τη μέρα. Αν έρθετε ξανά αύριο, μπορείτε να το καταγράψετε πάλι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Counted once a day. Come back tomorrow to log it again."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Counted once a day. Come back tomorrow to log it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo cuenta una vez al día. Si vuelves mañana, podrás guardarlo otra vez."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasketaan vain kerran päivässä. Jos tulet huomenna uudelleen, voit merkitä taas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compté une seule fois par jour. Revenez demain pour l’enregistrer à nouveau."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya dihitung sekali sehari. Datang lagi besok untuk mencatat lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta una sola volta al giorno. Se torni domani, potrai registrarlo di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1日に1回だけ数えます。明日また来れば、また残せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루에 한 번만 셉니다. 내일 다시 오면 또 남길 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telles bare én gang om dagen. Kommer du igjen i morgen, kan du lagre igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telt maar één keer per dag. Kom je morgen terug, dan kun je het opnieuw vastleggen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liczy się raz dziennie. Wróć jutro, aby zapisać ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta só uma vez por dia. Volte amanhã para registrar de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Считается раз в день. Приходите завтра, чтобы отметить снова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Räknas bara en gång per dag. Kommer du tillbaka i morgon kan du spara igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นับวันละครั้งเท่านั้น พรุ่งนี้กลับมาก็บันทึกได้อีก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günde yalnızca bir kez sayılır. Yarın yine gelirsen tekrar kaydedebilirsin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ tính một lần mỗi ngày. Mai quay lại sẽ ghi được nữa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天只计一次。明天再来还能再记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天只計一次。明天再來還能再記錄。"
          }
        }
      }
    },
