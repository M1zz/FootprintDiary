    "창 안에 담긴 것만 남고 배경은 지워져요" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zůstane jen to, co je v rámečku; pozadí se vymaže"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun det, der er inde i rammen, bliver tilbage; baggrunden slettes"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur was im Rahmen liegt, bleibt; der Hintergrund wird entfernt"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μένει μόνο ό,τι είναι μέσα στο πλαίσιο· το φόντο σβήνεται"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only what's inside the frame stays; the background is erased"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only what's inside the frame stays; the background is erased"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo queda lo que está dentro del marco; el fondo se borra"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain kehyksen sisällä oleva jää jäljelle, tausta häviää"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seul ce qui est dans le cadre est conservé ; l’arrière-plan est effacé"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya yang ada di dalam bingkai yang tersisa, latarnya dihapus"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resta solo ciò che è nella cornice; lo sfondo viene cancellato"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "枠の中に入ったものだけが残り、背景は消えます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "창 안에 담긴 것만 남고 배경은 지워져요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare det som er innenfor rammen, blir igjen; bakgrunnen fjernes"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen wat binnen het kader valt, blijft over; de achtergrond wordt gewist"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zostaje tylko to, co jest w ramce; tło jest usuwane"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só o que está dentro da moldura fica; o fundo é apagado"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Остаётся только то, что в рамке, а фон стирается"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bara det som är inom ramen blir kvar; bakgrunden raderas"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เหลือเฉพาะสิ่งที่อยู่ในกรอบ ส่วนพื้นหลังจะถูกลบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca çerçevenin içindekiler kalır, arka plan silinir"
          }
        },
