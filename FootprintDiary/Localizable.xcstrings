    "Face ID나 Touch ID로 앱을 잠가 내가 걸은 곳과 일기를 지켜요." : {
      "comment" : "Roadmap item detail: Face ID lock",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lock the app with Face ID or Touch ID to keep where you've been and your diary private."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID나 Touch ID로 앱을 잠가 내가 걸은 곳과 일기를 지켜요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lock the app with Face ID or Touch ID to keep where you've been and your diary private."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face IDまたはTouch IDでアプリをロックして、歩いた場所と日記を守ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 Face ID 或 Touch ID 锁定 App，守护你走过的地方和日记。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 Face ID 或 Touch ID 鎖定 App，守護你走過的地方和日記。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloquea la app con Face ID o Touch ID para proteger dónde has estado y tu diario."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sperre die App mit Face ID oder Touch ID, um deine Wege und dein Tagebuch zu schützen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verrouillez l’app avec Face ID ou Touch ID pour protéger vos lieux et votre journal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocca l’app con Face ID o Touch ID per proteggere i tuoi percorsi e il diario."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
