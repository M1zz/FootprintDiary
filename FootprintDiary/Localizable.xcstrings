          }
        }
      }
    },
    "걸으면 지나온 길이 순서대로 쌓입니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak jdeš, projité cesty se vrství v pořadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du går, lægger de gennemgåede veje sig oven på hinanden i rækkefølge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Gehen stapeln sich die zurückgelegten Wege der Reihe nach."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καθώς περπατάτε, οι διαδρομές που περνάτε στοιβάζονται με τη σειρά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As you walk, the paths you've passed stack up in order."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As you walk, the paths you've passed stack up in order."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A medida que caminas, los caminos recorridos se van apilando en orden."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun kävelet, kulkemasi tiet kasautuvat järjestyksessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En marchant, les chemins parcourus s’empilent dans l’ordre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat kamu berjalan, jalan yang dilalui menumpuk berurutan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentre cammini, i percorsi fatti si sovrappongono in ordine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歩くと、通った道が順に重なっていきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "걸으면 지나온 길이 순서대로 쌓입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du går, legger veiene du har gått seg oppå hverandre i rekkefølge."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terwijl je loopt, stapelen de doorlopen wegen zich in volgorde op."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy idziesz, przebyte drogi nakładają się po kolei."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conforme você caminha, os caminhos percorridos vão se empilhando em ordem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
