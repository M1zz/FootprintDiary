    "이번 주, 이번 달, 올해처럼 기간을 골라 그때 걸은 길과 도장만 볼 수 있어요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyber období, třeba tento týden, měsíc nebo rok, a uvidíš jen cesty a razítka z té doby."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg en periode som denne uge, måned eller år, og se kun veje og stempler fra den tid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle einen Zeitraum wie diese Woche, diesen Monat oder dieses Jahr und sieh nur die Wege und Stempel aus dieser Zeit."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε περίοδο, όπως αυτή την εβδομάδα, τον μήνα ή φέτος, και δείτε μόνο τις διαδρομές και τις σφραγίδες της."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a period like this week, this month or this year to see only the paths and stamps from that time."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a period like this week, this month or this year to see only the paths and stamps from that time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un periodo, como esta semana, este mes o este año, y ve solo los caminos y sellos de entonces."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse jakso, kuten tämä viikko, kuukausi tai vuosi, ja näe vain silloin kävellyt tiet ja leimat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une période, comme cette semaine, ce mois-ci ou cette année, pour ne voir que les chemins et tampons de ce moment-là."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih periode seperti minggu ini, bulan ini, atau tahun ini untuk melihat jalan yang kamu lalui dan stempel pada periode itu saja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un periodo, come questa settimana, questo mese o quest’anno, e vedi solo i percorsi e i timbri di quel momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今週、今月、今年のように期間を選んで、その間に歩いた道とスタンプだけを見られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이번 주, 이번 달, 올해처럼 기간을 골라 그때 걸은 길과 도장만 볼 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg en periode som denne uken, måneden eller året, og se bare veiene og stemplene fra den tiden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies een periode zoals deze week, deze maand of dit jaar en zie alleen de wegen en stempels van toen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz okres, np. ten tydzień, miesiąc lub rok, i zobacz tylko drogi i pieczątki z tego czasu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um período, como esta semana, este mês ou este ano, e veja só os caminhos e carimbos dessa época."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите период — эта неделя, месяц или год — и смотрите только пути и штампы за это время."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj en period, som den här veckan, månaden eller året, och se bara vägarna du gick och stämplarna du satte då."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกช่วงเวลา เช่น สัปดาห์นี้ เดือนนี้ ปีนี้ แล้วดูเฉพาะเส้นทางที่เดินและตราประทับในช่วงนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu hafta, bu ay, bu yıl gibi bir dönem seçip yalnızca o dönemde yürüdüğün yolları ve damgaları görebilirsin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn khoảng thời gian như tuần này, tháng này, năm nay để chỉ xem đường đã đi và con dấu trong khoảng đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择本周、本月、今年等时间段，只看那段时间走过的路和盖下的图章。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇本週、本月、今年等期間，只看那段期間走過的路和蓋下的印章。"
          }
        }
      }
    },
    "이제 걸어 보세요" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teď si vyraz na procházku"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu kan du gå en tur"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jetzt geh los"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τώρα βγείτε για περπάτημα"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Now Go for a Walk"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Now Go for a Walk"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora sal a caminar"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähde nyt kävelemään"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À vous de marcher maintenant"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekarang Cobalah Berjalan"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ora vai a camminare"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "さあ、歩いてみましょう"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 걸어 보세요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå en tur nå"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga nu lopen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teraz wyrusz na spacer"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agora vá caminhar"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "А теперь отправляйтесь гулять"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå ut på en promenad nu"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทีนี้ลองออกไปเดินดู"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şimdi Yürümeye Çık"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giờ hãy đi bộ thử nào"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在出发走走吧"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在出發走走吧"
          }
        }
      }
    },
    "이제 걸어 보세요.\n지나온 자리가 한 점씩 이 종이에 찍힙니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teď si vyraz na procházku.\nMísta, kudy půjdeš, se otisknou na tento papír bod po bodu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu kan du gå en tur.\nDe steder, du kommer forbi, stemples på dette papir et punkt ad gangen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jetzt geh los.\nDie Orte, an denen du vorbeikommst, werden Punkt für Punkt auf dieses Blatt gestempelt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τώρα βγείτε για περπάτημα.\nΤα μέρη απ' όπου περνάτε αποτυπώνονται σε αυτό το χαρτί ένα σημείο τη φορά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Now go for a walk.\nThe places you pass are marked on this sheet, one dot at a time."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Now go for a walk.\nThe places you pass are marked on this sheet, one dot at a time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora sal a caminar.\nLos lugares por los que pases se marcarán en esta hoja, punto a punto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähde nyt kävelemään.\nPaikat, joiden ohi kuljet, painautuvat tälle paperille piste kerrallaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À vous de marcher maintenant.\nLes lieux où vous passez se marquent sur cette feuille, un point après l’autre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekarang cobalah berjalan.\nTempat yang kamu lalui tercap di kertas ini satu titik demi satu titik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ora vai a camminare.\nI luoghi per cui passi si imprimono su questo foglio, un punto alla volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "さあ、歩いてみましょう。\n通った場所が一点ずつこの紙に刻まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 걸어 보세요.\n지나온 자리가 한 점씩 이 종이에 찍힙니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå en tur nå.\nStedene du passerer, stemples på dette arket ett punkt om gangen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga nu lopen.\nDe plekken waar je langskomt worden punt voor punt op dit vel gestempeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teraz wyrusz na spacer.\nMiejsca, które mijasz, odbijają się na tej kartce punkt po punkcie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agora vá caminhar.\nOs lugares por onde você passa são marcados nesta folha, um ponto de cada vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "А теперь отправляйтесь гулять.\nМеста, где вы проходите, ложатся на этот лист точка за точкой."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå ut på en promenad nu.\nPlatserna du passerar stämplas på det här pappret punkt för punkt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทีนี้ลองออกไปเดินดู\nที่ที่ผ่านจะถูกประทับลงบนกระดาษแผ่นนี้ทีละจุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şimdi yürümeye çık.\nGeçtiğin yerler bu kâğıda nokta nokta işlenir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giờ hãy đi bộ thử nào.\nNhững nơi bạn đi qua sẽ được in lên tờ giấy này từng điểm một."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
