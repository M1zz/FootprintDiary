    "아직 가보지 않은 자리라 다녀온 횟수를 세지 않습니다. 위치를 켜고 이 자리에 닿으면 가본 곳이 됩니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tady jsi ještě nebyl, takže se návštěvy nepočítají. Zapni polohu a až sem dojdeš, stane se z toho navštívené místo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har ikke været her endnu, så besøg tælles ikke. Slå lokalitet til, og når du når frem, bliver det et besøgt sted."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du warst noch nicht hier, daher werden keine Besuche gezählt. Schalte den Standort ein und erreiche diesen Ort, dann wird er zum besuchten Ort."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν έχετε πάει ακόμα εδώ, οπότε οι επισκέψεις δεν μετρώνται. Ενεργοποιήστε την τοποθεσία και, όταν φτάσετε, θα γίνει επισκέψιμο μέρος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You haven't been here yet, so visits aren't counted. Turn on Location and reach this spot to make it a visited place."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You haven't been here yet, so visits aren't counted. Turn on Location and reach this spot to make it a visited place."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no has estado aquí, así que no se cuentan las visitas. Activa la ubicación y llega a este lugar para que pase a ser visitado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et ole vielä käynyt täällä, joten käyntejä ei lasketa. Kun sijainti on päällä ja saavut paikalle, siitä tulee käyty paikka."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n’y êtes pas encore allé, les visites ne sont donc pas comptées. Activez la localisation et rendez-vous ici pour en faire un lieu visité."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu belum pernah ke tempat ini, jadi kunjungannya belum dihitung. Nyalakan lokasi dan datang ke sini agar jadi tempat yang dikunjungi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non ci sei ancora stato, quindi le visite non vengono contate. Attiva la posizione e raggiungi questo luogo per farlo diventare visitato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ行ったことのない場所なので、訪問回数は数えません。位置情報をオンにしてこの場所に着くと、行った場所になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 가보지 않은 자리라 다녀온 횟수를 세지 않습니다. 위치를 켜고 이 자리에 닿으면 가본 곳이 됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har ikke vært her ennå, så besøk telles ikke. Slå på posisjon, og når du kommer fram, blir det et besøkt sted."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bent hier nog niet geweest, dus bezoeken worden niet geteld. Zet locatie aan en kom hier, dan wordt het een bezochte plek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeszcze tu nie byłeś, więc wizyty nie są liczone. Włącz lokalizację, a gdy dotrzesz, miejsce stanie się odwiedzone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você ainda não esteve aqui, então as visitas não são contadas. Ative a localização e, ao chegar, ele vira um lugar visitado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы здесь ещё не были, поэтому посещения не считаются. Включите геопозицию — когда дойдёте, место станет посещённым."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har inte varit här än, så besöken räknas inte. Slå på platstjänster och kom hit, så blir det en besökt plats."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยังไม่เคยไปที่นี่จึงยังไม่นับจำนวนครั้งที่ไป เปิดตำแหน่งแล้วไปถึงที่นี่ จะกลายเป็นที่ที่ไปมาแล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz gitmediğin bir yer olduğu için ziyaret sayısı tutulmaz. Konumu açıp buraya vardığında gidilmiş yer olur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn chưa từng tới nơi này nên chưa đếm số lần tới. Bật vị trí và tới đây thì nơi này sẽ thành nơi đã tới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是还没去过的地方，所以不计算到访次数。开启定位并走到这里后，就会变成去过的地方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是還沒去過的地方，所以不計算造訪次數。開啟定位並走到這裡後，就會變成去過的地方。"
          }
        }
      }
    },
    "아직 가보지 않은 자리예요. ‘가볼 곳’으로 남고, 그 자리에 닿으면 다녀온 곳이 됩니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ještě jsi tu nebyl. Zůstane jako „Chci navštívit“ a po příchodu se z něj stane navštívené místo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har ikke været her endnu. Det bliver stående som „Vil besøge“ og bliver et besøgt sted, når du når frem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du warst noch nicht hier. Der Ort bleibt als „Möchte ich besuchen“ erhalten und wird zum besuchten Ort, sobald du ihn erreichst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν έχετε πάει ακόμα εδώ. Μένει ως «Θέλω να πάω» και γίνεται επισκέψιμο μέρος όταν φτάσετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You haven't been here yet. It stays as a \"Want to Visit\" spot and becomes a visited place once you arrive."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You haven't been here yet. It stays as a \"Want to Visit\" spot and becomes a visited place once you arrive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no has estado aquí. Quedará como «Para visitar» y pasará a ser un lugar visitado cuando llegues."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et ole vielä käynyt täällä. Se jää ”Haluan käydä” -paikaksi ja muuttuu käydyksi, kun saavut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n’y êtes pas encore allé. Il reste dans « À visiter » et devient un lieu visité quand vous y arrivez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu belum pernah ke sini. Tetap tercatat sebagai \"Ingin Dikunjungi\" dan menjadi tempat yang dikunjungi saat kamu tiba."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non ci sei ancora stato. Resta tra i «Da visitare» e diventa un luogo visitato quando ci arrivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ行ったことのない場所です。「行きたい場所」として残り、そこに着くと行った場所になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 가보지 않은 자리예요. ‘가볼 곳’으로 남고, 그 자리에 닿으면 다녀온 곳이 됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har ikke vært her ennå. Det blir stående som «Vil besøke» og blir et besøkt sted når du kommer fram."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bent hier nog niet geweest. Het blijft staan als ‘Wil ik bezoeken’ en wordt een bezochte plek zodra je aankomt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeszcze tu nie byłeś. Miejsce zostaje jako „Do odwiedzenia” i staje się odwiedzone, gdy dotrzesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você ainda não esteve aqui. Ele fica como «Para visitar» e vira um lugar visitado quando você chegar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы здесь ещё не были. Место останется в «Хочу посетить» и станет посещённым, когда вы дойдёте."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har inte varit här än. Den blir kvar som ”Vill besöka” och blir en besökt plats när du kommer fram."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยังไม่เคยไปที่นี่ จะเหลือเป็น \"ที่อยากไป\" และเมื่อไปถึงจะกลายเป็นที่ที่ไปมาแล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burada henüz bulunmadın. “Gitmek İstediğim” olarak kalır, vardığında gidilmiş yer olur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn chưa từng tới đây. Nơi này sẽ giữ ở mục \"Muốn tới\" và thành nơi đã tới khi bạn đến."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
