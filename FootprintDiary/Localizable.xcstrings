    "집·일터처럼 기준이 될 만한 것으로 골라 주세요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "집·일터처럼 기준이 될 만한 것으로 골라 주세요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick something that can serve as a reference, like home or work."
          }
