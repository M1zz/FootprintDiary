    "이제 걸어 보세요" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 걸어 보세요"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Now Go for a Walk"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Now Go for a Walk"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "さあ、歩いてみましょう"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在出发走走吧"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在出發走走吧"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora sal a caminar"
          }
