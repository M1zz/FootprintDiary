    "세상은 이미 다른 지도가 다 그려 두었어요.\n여기에는 **당신이 두 발로 지난 자리만** 남습니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세상은 이미 다른 지도가 다 그려 두었어요.\n여기에는 **당신이 두 발로 지난 자리만** 남습니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Other maps have already drawn the whole world.\nHere, only **the places you've walked** remain."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Other maps have already drawn the whole world.\nHere, only **the places you've walked** remain."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "世界はもう、ほかの地図が描き終えています。\nここに残るのは、**あなたが自分の足で通った場所だけ**です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "世界早已被别的地图画满。\n而这里只留下**你亲脚走过的地方**。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "世界早已被別的地圖畫滿。\n而這裡只留下**你親腳走過的地方**。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los demás mapas ya dibujaron el mundo entero.\nAquí solo quedan **los lugares que pisaste con tus propios pies**."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Welt haben andere Karten längst gezeichnet.\nHier bleibt **nur, wo du mit deinen eigenen Füßen warst**."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le monde a déjà été dessiné par d’autres cartes.\nIci ne restent que **les lieux que vous avez foulés de vos propres pieds**."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il mondo è già stato disegnato dalle altre mappe.\nQui resta **solo dove sei passato con i tuoi piedi**."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O mundo já foi desenhado por outros mapas.\nAqui fica **só onde você passou com os próprios pés**."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Весь мир уже нарисовали другие карты.\nЗдесь останутся **только места, где вы прошли своими ногами**."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โลกถูกแผนที่อื่นวาดไว้หมดแล้ว\nที่นี่จะเหลือ **เพียงที่ที่คุณก้าวผ่านด้วยสองเท้าของตัวเอง**"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thế giới đã được các bản đồ khác vẽ hết rồi.\nỞ đây chỉ còn lại **những nơi bạn đã đi qua bằng chính đôi chân mình**."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svět už nakreslily jiné mapy.\nTady zůstane **jen to, kudy jsi prošel vlastníma nohama**."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verden er allerede tegnet af andre kort.\nHer bliver **kun de steder, du har gået med dine egne fødder**."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τον κόσμο τον έχουν ήδη σχεδιάσει άλλοι χάρτες.\nΕδώ μένουν **μόνο τα μέρη που περάσατε με τα ίδια σας τα πόδια**."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muut kartat ovat jo piirtäneet maailman.\nTähän jäävät **vain paikat, joissa olet kulkenut omin jaloin**."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dunia sudah digambar oleh peta-peta lain.\nDi sini hanya tersisa **tempat yang kamu lalui dengan kakimu sendiri**."
          }
        }
      }
    },
