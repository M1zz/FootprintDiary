        }
      }
    },
    "걸으면 지나온 길이 순서대로 쌓입니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "걸으면 지나온 길이 순서대로 쌓입니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As you walk, the paths you've passed stack up in order."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As you walk, the paths you've passed stack up in order."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歩くと、通った道が順に重なっていきます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一路走来，经过的路会依次叠加。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一路走來，經過的路會依序疊加。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A medida que caminas, los caminos recorridos se van apilando en orden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Gehen stapeln sich die zurückgelegten Wege der Reihe nach."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En marchant, les chemins parcourus s’empilent dans l’ordre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentre cammini, i percorsi fatti si sovrappongono in ordine."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conforme você caminha, os caminhos percorridos vão se empilhando em ordem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока вы идёте, пройденные пути накладываются друг на друга по порядку."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเดิน เส้นทางที่ผ่านมาจะซ้อนทับกันตามลำดับ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bạn đi, những con đường đã qua sẽ chồng lên nhau theo thứ tự."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak jdeš, projité cesty se vrství v pořadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du går, lægger de gennemgåede veje sig oven på hinanden i rækkefølge."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
