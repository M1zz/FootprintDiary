          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À vous de marcher maintenant"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ora vai a camminare"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agora vá caminhar"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "А теперь отправляйтесь гулять"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทีนี้ลองออกไปเดินดู"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giờ hãy đi bộ thử nào"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teď si vyraz na procházku"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu kan du gå en tur"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τώρα βγείτε για περπάτημα"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähde nyt kävelemään"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekarang Cobalah Berjalan"
          }
        }
      }
    },
    "이제 걸어 보세요.\n지나온 자리가 한 점씩 이 종이에 찍힙니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 걸어 보세요.\n지나온 자리가 한 점씩 이 종이에 찍힙니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Now go for a walk.\nThe places you pass are marked on this sheet, one dot at a time."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Now go for a walk.\nThe places you pass are marked on this sheet, one dot at a time."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "さあ、歩いてみましょう。\n通った場所が一点ずつこの紙に刻まれます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在出发走走吧。\n经过的地方会一点点印在这张纸上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在出發走走吧。\n經過的地方會一點一點印在這張紙上。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora sal a caminar.\nLos lugares por los que pases se marcarán en esta hoja, punto a punto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jetzt geh los.\nDie Orte, an denen du vorbeikommst, werden Punkt für Punkt auf dieses Blatt gestempelt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À vous de marcher maintenant.\nLes lieux où vous passez se marquent sur cette feuille, un point après l’autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ora vai a camminare.\nI luoghi per cui passi si imprimono su questo foglio, un punto alla volta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agora vá caminhar.\nOs lugares por onde você passa são marcados nesta folha, um ponto de cada vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "А теперь отправляйтесь гулять.\nМеста, где вы проходите, ложатся на этот лист точка за точкой."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทีนี้ลองออกไปเดินดู\nที่ที่ผ่านจะถูกประทับลงบนกระดาษแผ่นนี้ทีละจุด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giờ hãy đi bộ thử nào.\nNhững nơi bạn đi qua sẽ được in lên tờ giấy này từng điểm một."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teď si vyraz na procházku.\nMísta, kudy půjdeš, se otisknou na tento papír bod po bodu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu kan du gå en tur.\nDe steder, du kommer forbi, stemples på dette papir et punkt ad gangen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τώρα βγείτε για περπάτημα.\nΤα μέρη απ' όπου περνάτε αποτυπώνονται σε αυτό το χαρτί ένα σημείο τη φορά."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähde nyt kävelemään.\nPaikat, joiden ohi kuljet, painautuvat tälle paperille piste kerrallaan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekarang cobalah berjalan.\nTempat yang kamu lalui tercap di kertas ini satu titik demi satu titik."
          }
        }
      }
    },
    "일기를 쓰다가 앱이 꺼져도 쓰던 내용이 남아 있어요." : {
      "comment" : "Roadmap item detail: keep unsaved drafts",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the app closes while you're writing a diary entry, what you wrote is still there."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일기를 쓰다가 앱이 꺼져도 쓰던 내용이 남아 있어요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the app closes while you're writing a diary entry, what you wrote is still there."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日記を書いている途中でアプリが終了しても、書きかけの内容が残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写日记时即使 App 被关闭，写到一半的内容也会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寫日記時即使 App 被關閉，寫到一半的內容也會保留。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la app se cierra mientras escribes el diario, lo que habías escrito sigue ahí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn die App beim Schreiben des Tagebuchs beendet wird, bleibt das Geschriebene erhalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si l’app se ferme pendant que vous écrivez votre journal, ce que vous aviez écrit est conservé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se l’app si chiude mentre scrivi il diario, quello che hai scritto resta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se o app fechar enquanto você escreve o diário, o que já foi escrito continua lá."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если приложение закроется во время записи дневника, написанное сохранится."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากแอปปิดขณะเขียนไดอารี่ สิ่งที่เขียนไว้ยังอยู่"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu ứng dụng tắt khi bạn đang viết nhật ký, phần đã viết vẫn còn."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud se aplikace při psaní deníku vypne, napsané zůstane."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis appen lukker, mens du skriver dagbog, bliver det skrevne stående."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν η εφαρμογή κλείσει ενώ γράφετε στο ημερολόγιο, όσα γράψατε μένουν."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos appi sulkeutuu päiväkirjaa kirjoittaessasi, kirjoittamasi säilyy."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika aplikasi tertutup saat menulis catatan harian, tulisanmu tetap ada."
          }
        }
      }
    },
