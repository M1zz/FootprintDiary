    "지나온 자리가 한 점씩 이 종이에 찍힙니다.\n차나 지하철로 지난 길은 그려지지 않아요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지나온 자리가 한 점씩 이 종이에 찍힙니다.\n차나 지하철로 지난 길은 그려지지 않아요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The places you pass are marked on this sheet, one dot at a time.\nRoads you pass by car or subway aren't drawn."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The places you pass are marked on this sheet, one dot at a time.\nRoads you pass by car or train aren't drawn."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通った場所が一点ずつこの紙に刻まれます。\n車や地下鉄で通った道は描かれません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "经过的地方会一点点印在这张纸上。\n乘车或地铁经过的路不会被画出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "經過的地方會一點一點印在這張紙上。\n搭車或捷運經過的路不會被畫出。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los lugares por los que pases se marcarán en esta hoja, punto a punto.\nLos caminos que recorres en coche o metro no se dibujan."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Orte, an denen du vorbeikommst, werden Punkt für Punkt auf dieses Blatt gestempelt.\nWege mit Auto oder U-Bahn werden nicht gezeichnet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les lieux où vous passez se marquent sur cette feuille, un point après l’autre.\nLes chemins parcourus en voiture ou en métro ne sont pas dessinés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I luoghi per cui passi si imprimono su questo foglio, un punto alla volta.\nI percorsi fatti in auto o in metropolitana non vengono disegnati."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os lugares por onde você passa são marcados nesta folha, um ponto de cada vez.\nCaminhos feitos de carro ou metrô não são desenhados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Места, где вы проходите, ложатся на этот лист точка за точкой.\nПути, пройденные на машине или в метро, не рисуются."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ที่ที่ผ่านจะถูกประทับลงบนกระดาษแผ่นนี้ทีละจุด\nเส้นทางที่ผ่านด้วยรถยนต์หรือรถไฟใต้ดินจะไม่ถูกวาด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Những nơi bạn đi qua sẽ được in lên tờ giấy này từng điểm một.\nĐường đi bằng ô tô hay tàu điện ngầm sẽ không được vẽ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Místa, kudy půjdeš, se otisknou na tento papír bod po bodu.\nCesty projeté autem nebo metrem se nekreslí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De steder, du kommer forbi, stemples på dette papir et punkt ad gangen.\nVeje, du kører i bil eller metro, tegnes ikke."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα μέρη απ' όπου περνάτε αποτυπώνονται σε αυτό το χαρτί ένα σημείο τη φορά.\nΟι δρόμοι που περνάτε με αυτοκίνητο ή μετρό δεν σχεδιάζονται."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paikat, joiden ohi kuljet, painautuvat tälle paperille piste kerrallaan.\nAutolla tai metrolla kuljettuja teitä ei piirretä."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempat yang kamu lalui tercap di kertas ini satu titik demi satu titik.\nJalan yang dilalui dengan mobil atau kereta bawah tanah tidak digambar."
          }
        }
      }
    },
