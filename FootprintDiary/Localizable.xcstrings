          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hiervandaan. Binnen %lld m wordt het een bezochte plek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stąd %@. W promieniu %lld m miejsce stanie się odwiedzone."
