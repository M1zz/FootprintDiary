        }
      }
    },
    "위치를 '항상 허용'으로, 동작 및 피트니스를 켜 두면 앱을 열지 않고 걸어도 기록됩니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위치를 '항상 허용'으로, 동작 및 피트니스를 켜 두면 앱을 열지 않고 걸어도 기록됩니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set location to \"Always\" and turn on Motion & Fitness, and your walks are recorded even without opening the app."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set location to \"Always\" and turn on Motion & Fitness, and your walks are recorded even without opening the app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報を「常に許可」にして、モーションとフィットネスをオンにしておくと、アプリを開かずに歩いても記録されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将定位设为“始终”，并开启“运动与健身”，即使不打开 App 步行也会被记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將定位設為「永遠」，並開啟「體能活動」，即使不開啟 App 步行也會被記錄。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si pones la ubicación en «Siempre» y activas Movimiento y forma física, tus caminatas se registran sin abrir la app."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellst du den Standort auf „Immer“ und aktivierst Bewegung & Fitness, wird auch aufgezeichnet, ohne dass du die App öffnest."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la localisation est sur « Toujours » et que Mouvement et forme est activé, vos marches sont enregistrées sans ouvrir l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta la posizione su «Sempre» e attiva Movimento e fitness: i tuoi percorsi vengono registrati anche senza aprire l’app."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com a localização em «Sempre» e Movimento e Condicionamento ativados, suas caminhadas são registradas sem abrir o app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если выбрать для геопозиции «Всегда» и включить «Движение и фитнес», прогулки записываются, даже когда приложение закрыто."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตั้งตำแหน่งเป็น \"เสมอ\" และเปิด \"การเคลื่อนไหวและฟิตเนส\" แล้ว แม้ไม่ได้เปิดแอปก็จะบันทึกการเดินให้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt vị trí là \"Luôn luôn\" và bật Chuyển động & Thể dục thì dù không mở ứng dụng, việc đi bộ vẫn được ghi lại."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když nastavíš polohu na „Vždy“ a zapneš Pohyb a kondici, chůze se zaznamenává i bez otevření aplikace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sæt lokalitet til „Altid“ og slå Bevægelse og fitness til, så registreres dine ture, selv uden at åbne appen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν ορίσετε την τοποθεσία σε «Πάντα» και ενεργοποιήσετε το «Κίνηση και φυσική κατάσταση», το περπάτημα καταγράφεται χωρίς να ανοίξετε την εφαρμογή."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun asetat sijainnin tilaan ”Aina” ja otat käyttöön Liike ja kunto, kävelysi tallentuu ilman että avaat appia."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atur lokasi ke \"Selalu\" dan aktifkan Gerakan & Kebugaran, maka jalan kakimu tercatat tanpa membuka aplikasi."
          }
        }
      }
    },
