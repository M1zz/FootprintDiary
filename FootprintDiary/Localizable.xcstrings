    "차나 지하철로 지난 길은 그려지지 않아요.\n걸어야만 한 점씩 찍힙니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "차나 지하철로 지난 길은 그려지지 않아요.\n걸어야만 한 점씩 찍힙니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roads you pass by car or subway aren't drawn.\nOnly walking puts down a dot at a time."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roads you pass by car or train aren't drawn.\nOnly walking puts down a dot at a time."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "車や地下鉄で通った道は描かれません。\n歩いたときだけ、一点ずつ刻まれます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "乘车或地铁经过的路不会被画出。\n只有步行，才会一点一点落下印记。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搭車或捷運經過的路不會被畫出。\n只有步行，才會一點一點落下印記。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los caminos que recorres en coche o metro no se dibujan.\nSolo al caminar se marca un punto tras otro."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wege, die du mit dem Auto oder der U-Bahn zurücklegst, werden nicht gezeichnet.\nNur beim Gehen entsteht Punkt für Punkt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les chemins parcourus en voiture ou en métro ne sont pas dessinés.\nSeule la marche fait apparaître un point après l’autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I percorsi fatti in auto o in metropolitana non vengono disegnati.\nSolo camminando compare un punto alla volta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caminhos feitos de carro ou metrô não são desenhados.\nSó caminhando surge um ponto de cada vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пути, пройденные на машине или в метро, не рисуются.\nТолько ходьба оставляет точку за точкой."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เส้นทางที่ผ่านด้วยรถยนต์หรือรถไฟใต้ดินจะไม่ถูกวาด\nต้องเดินเท่านั้นจึงจะประทับทีละจุด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đường đi bằng ô tô hay tàu điện ngầm sẽ không được vẽ.\nChỉ khi đi bộ mới in lên từng điểm một."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cesty projeté autem nebo metrem se nekreslí.\nJen chůze otiskuje bod po bodu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veje, du kører i bil eller metro, tegnes ikke.\nKun når du går, sættes der et punkt ad gangen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι δρόμοι που περνάτε με αυτοκίνητο ή μετρό δεν σχεδιάζονται.\nΜόνο όταν περπατάτε μπαίνει ένα σημείο τη φορά."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autolla tai metrolla kuljettuja teitä ei piirretä.\nVain kävely painaa pisteen kerrallaan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jalan yang dilalui dengan mobil atau kereta bawah tanah tidak digambar.\nHanya berjalan kaki yang mencap satu titik demi satu titik."
          }
        }
      }
    },
    "창 안에 담긴 것만 남고 배경은 지워져요" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "창 안에 담긴 것만 남고 배경은 지워져요"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only what's inside the frame stays; the background is erased"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only what's inside the frame stays; the background is erased"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "枠の中に入ったものだけが残り、背景は消えます"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只保留框内的内容，背景会被抹去"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只保留框內的內容，背景會被抹去"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo queda lo que está dentro del marco; el fondo se borra"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur was im Rahmen liegt, bleibt; der Hintergrund wird entfernt"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seul ce qui est dans le cadre est conservé ; l’arrière-plan est effacé"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resta solo ciò che è nella cornice; lo sfondo viene cancellato"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só o que está dentro da moldura fica; o fundo é apagado"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Остаётся только то, что в рамке, а фон стирается"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เหลือเฉพาะสิ่งที่อยู่ในกรอบ ส่วนพื้นหลังจะถูกลบ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ giữ lại phần nằm trong khung, nền sẽ bị xóa"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zůstane jen to, co je v rámečku; pozadí se vymaže"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun det, der er inde i rammen, bliver tilbage; baggrunden slettes"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μένει μόνο ό,τι είναι μέσα στο πλαίσιο· το φόντο σβήνεται"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain kehyksen sisällä oleva jää jäljelle, tausta häviää"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
