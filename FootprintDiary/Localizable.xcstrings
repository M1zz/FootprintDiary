    "걷기 기록이 꺼져 있어요. 걸어도 길이 남지 않아요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "걷기 기록이 꺼져 있어요. 걸어도 길이 남지 않아요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walk tracking is off. Your path won't be saved as you walk."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walk tracking is off. Your path won't be saved as you walk."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歩行記録がオフです。歩いても道は残りません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "步行记录已关闭。走再多路也不会留下轨迹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "步行紀錄已關閉。走再多路也不會留下軌跡。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El registro de caminatas está desactivado. Aunque camines, no quedará rastro."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wegaufzeichnung ist aus. Auch wenn du gehst, bleibt keine Spur."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enregistrement des marches est désactivé. Même en marchant, aucune trace ne sera gardée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La registrazione dei percorsi è disattivata. Anche se cammini, non resta alcuna traccia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O registro de caminhadas está desligado. Mesmo caminhando, não ficará rastro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запись прогулок выключена. Даже если вы идёте, след не останется."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การบันทึกการเดินปิดอยู่ ต่อให้เดินก็จะไม่เหลือเส้นทาง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghi lại việc đi bộ đang tắt. Dù bạn đi bộ cũng sẽ không để lại đường nào."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Záznam chůze je vypnutý. I když půjdeš, žádná stopa nezůstane."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gangregistrering er slået fra. Selv hvis du går, efterlades der intet spor."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η καταγραφή περπατήματος είναι απενεργοποιημένη. Ακόμα κι αν περπατήσετε, δεν θα μείνει ίχνος."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kävelyn tallennus on pois päältä. Vaikka kävelisit, jälkeä ei jää."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pencatatan jalan kaki mati. Meski kamu berjalan, tidak ada jejak yang tersimpan."
          }
        }
      }
    },
    "걷다가 스탬프를 찍으면 여기에 시간 순서대로 쌓입니다.\n머문 자리는 찍지 않아도 저절로 남습니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "걷다가 스탬프를 찍으면 여기에 시간 순서대로 쌓입니다.\n머문 자리는 찍지 않아도 저절로 남습니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stamps you place while walking pile up here in time order.\nPlaces you stay at are saved on their own, no stamp needed."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stamps you place while walking pile up here in time order.\nPlaces you stay at are saved on their own, no stamp needed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歩きながらスタンプを押すと、ここに時間順に積み重なります。\n滞在した場所は、押さなくても自動で残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "步行时盖下的图章会按时间顺序堆叠在这里。\n停留过的地方即使不盖章也会自动保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "步行時蓋下的印章會依時間順序堆疊在這裡。\n停留過的地方即使不蓋章也會自動保留。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los sellos que pongas al caminar se apilan aquí en orden cronológico.\nLos lugares donde te detienes se guardan solos, sin sellar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stempel, die du beim Gehen setzt, stapeln sich hier in zeitlicher Reihenfolge.\nOrte, an denen du verweilst, werden auch ohne Stempel von selbst festgehalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tampons posés en marchant s’empilent ici par ordre chronologique.\nLes lieux où vous restez sont gardés tout seuls, sans tampon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I timbri messi mentre cammini si accumulano qui in ordine cronologico.\nI luoghi in cui ti fermi vengono salvati da soli, senza timbro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os carimbos colocados ao caminhar se acumulam aqui em ordem cronológica.\nLugares onde você fica parado são guardados sozinhos, sem carimbo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Штампы, поставленные на прогулке, накапливаются здесь по порядку времени.\nМеста, где вы задержались, сохраняются сами, даже без штампа."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตราประทับที่ประทับระหว่างเดินจะสะสมที่นี่ตามลำดับเวลา\nที่ที่แวะอยู่จะถูกเก็บไว้เองโดยไม่ต้องประทับ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con dấu đóng khi đi bộ sẽ xếp ở đây theo thứ tự thời gian.\nNơi bạn dừng lại sẽ tự được giữ lại mà không cần đóng dấu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Razítka otištěná při chůzi se tu skládají v pořadí času.\nMísta, kde se zdržíš, se uloží sama, i bez razítka."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stempler, du sætter, mens du går, hober sig op her i tidsrækkefølge.\nSteder, hvor du holder pause, gemmes af sig selv uden stempel."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι σφραγίδες που βάζετε περπατώντας στοιβάζονται εδώ με σειρά χρόνου.\nΤα μέρη όπου σταματάτε αποθηκεύονται μόνα τους, χωρίς σφραγίδα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kävellessä asettamasi leimat kasaantuvat tähän aikajärjestyksessä.\nPaikat, joissa viivyt, tallentuvat itsestään ilman leimaa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stempel yang kamu bubuhkan saat berjalan menumpuk di sini berurutan waktu.\nTempat yang kamu singgahi tersimpan sendiri tanpa stempel."
          }
        }
      }
    },
