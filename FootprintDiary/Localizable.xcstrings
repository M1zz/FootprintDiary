    "걸어서 도착하면 그 자리에서 사진을 남길 수 있어요" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "걸어서 도착하면 그 자리에서 사진을 남길 수 있어요"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walk there and you can take a photo on the spot"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walk there and you can take a photo on the spot"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歩いて着くと、その場所で写真を残せます"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "步行抵达后，就能在那里留下照片"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "步行抵達後，就能在那裡留下照片"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si llegas caminando, podrás sacar una foto allí mismo"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du zu Fuß ankommst, kannst du dort ein Foto aufnehmen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En arrivant à pied, vous pourrez prendre une photo sur place"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se arrivi a piedi, potrai scattare una foto sul posto"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao chegar a pé, você poderá tirar uma foto no local"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дойдя пешком, вы сможете сделать там фото"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเดินไปถึง จะถ่ายรูปไว้ที่นั่นได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi đi bộ tới nơi, bạn có thể chụp ảnh ngay tại đó"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když dojdeš pěšky, můžeš tam pořídit fotku"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
