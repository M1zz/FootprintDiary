    "내 개인 아이클라우드에만 담깁니다. 다른 사람에게 보이지 않아요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukládá se jen do tvého osobního iCloudu. Nikdo jiný to nevidí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemmes kun i din personlige iCloud. Andre kan ikke se det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird nur in deiner persönlichen iCloud gespeichert. Niemand sonst kann es sehen."
