    "지나온 자리가 한 점씩 이 종이에 찍힙니다.\n차나 지하철로 지난 길은 그려지지 않아요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지나온 자리가 한 점씩 이 종이에 찍힙니다.\n차나 지하철로 지난 길은 그려지지 않아요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The places you pass are marked on this sheet, one dot at a time.\nRoads you pass by car or subway aren't drawn."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The places you pass are marked on this sheet, one dot at a time.\nRoads you pass by car or train aren't drawn."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通った場所が一点ずつこの紙に刻まれます。\n車や地下鉄で通った道は描かれません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "经过的地方会一点点印在这张纸上。\n乘车或地铁经过的路不会被画出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "經過的地方會一點一點印在這張紙上。\n搭車或捷運經過的路不會被畫出。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los lugares por los que pases se marcarán en esta hoja, punto a punto.\nLos caminos que recorres en coche o metro no se dibujan."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Orte, an denen du vorbeikommst, werden Punkt für Punkt auf dieses Blatt gestempelt.\nWege mit Auto oder U-Bahn werden nicht gezeichnet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les lieux où vous passez se marquent sur cette feuille, un point après l’autre.\nLes chemins parcourus en voiture ou en métro ne sont pas dessinés."
          }
        }
      }
    },
