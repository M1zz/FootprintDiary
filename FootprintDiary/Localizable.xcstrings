    "지도를 **길게 누르면** 가볼 곳을 미리 찍어 둘 수 있어요" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Dlouhým podržením** mapy si předem označíš místo, kam chceš jít"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Tryk og hold** på kortet for at stemple et sted, du vil besøge"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Halte die Karte gedrückt**, um vorab einen Ort zum Besuchen zu stempeln"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με **παρατεταμένο πάτημα** στον χάρτη σημειώνετε από πριν ένα μέρος που θέλετε να πάτε"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Long-press** the map to stamp a place to visit ahead of time"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Long-press** the map to stamp a place to visit ahead of time"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Mantén pulsado** el mapa para sellar de antemano un lugar para visitar"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Paina karttaa pitkään** merkitäksesi paikan, jossa haluat käydä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Appuyez longuement** sur la carte pour tamponner à l’avance un lieu à visiter"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Tekan lama** peta untuk mencap tempat yang ingin dikunjungi lebih dulu"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Tieni premuta** la mappa per timbrare in anticipo un posto da visitare"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地図を**長押しすると**、行きたい場所をあらかじめ押しておけます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지도를 **길게 누르면** 가볼 곳을 미리 찍어 둘 수 있어요"
