        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu bạn đã đi bộ mà bản đồ không có đường nào, bạn có thể xem lý do ở đây."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud jsi šel, ale v mapě se nevykreslila čára, důvod najdeš tady."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
