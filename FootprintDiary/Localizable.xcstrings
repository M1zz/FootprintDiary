          "stringUnit" : {
            "state" : "translated",
            "value" : "You're %@ away. Come within %lld m to log a visit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás a %@. A menos de %lld m podrás guardar la visita."
