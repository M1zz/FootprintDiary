            "value" : "歩いて着いた場所"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "步行到达的地方"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "步行抵達的地方"
          }
        }
      }
    },
    "걸어서 도착하면 그 자리에서 사진을 남길 수 있어요" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "걸어서 도착하면 그 자리에서 사진을 남길 수 있어요"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walk there and you can take a photo on the spot"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walk there and you can take a photo on the spot"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歩いて着くと、その場所で写真を残せます"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "步行抵达后，就能在那里留下照片"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "步行抵達後，就能在那裡留下照片"
          }
        }
      }
    },
    "걸었는데 지도에 선이 그어지지 않으면 여기서 까닭을 볼 수 있어요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "걸었는데 지도에 선이 그어지지 않으면 여기서 까닭을 볼 수 있어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you walked but no line was drawn on the map, you can find out why here."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you walked but no line was drawn on the map, you can find out why here."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歩いたのに地図に線が引かれないときは、ここで理由を確認できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果走了路但地图上没有画出线，可以在这里查看原因。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果走了路但地圖上沒有畫出線，可以在這裡查看原因。"
          }
        }
      }
    },
    "걸으면 지나온 길이 순서대로 쌓입니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "걸으면 지나온 길이 순서대로 쌓입니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As you walk, the paths you've passed stack up in order."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As you walk, the paths you've passed stack up in order."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歩くと、通った道が順に重なっていきます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一路走来，经过的路会依次叠加。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一路走來，經過的路會依序疊加。"
          }
        }
      }
    },
    "걸은 길과 일기를 파일로 저장하고 다시 불러올 수 있어요." : {
      "comment" : "Roadmap item detail: backup and export",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save your walks and diary to a file and bring them back later."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "걸은 길과 일기를 파일로 저장하고 다시 불러올 수 있어요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save your walks and diary to a file and bring them back later."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歩いた道と日記をファイルに保存して、あとから読み込めます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把走过的路和日记存成文件，之后还能再导入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把走過的路和日記存成檔案，之後還能再匯入。"
          }
        }
      }
    },
    "고른 기간에 걸은 길과 그 기간에 찍은 도장만 지도에 남습니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고른 기간에 걸은 길과 그 기간에 찍은 도장만 지도에 남습니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only paths walked and stamps placed during the chosen period stay on the map."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only paths walked and stamps placed during the chosen period stay on the map."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選んだ期間に歩いた道と、その期間に押したスタンプだけが地図に残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有所选时间段内走过的路和盖下的图章会留在地图上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有所選期間內走過的路和蓋下的印章會留在地圖上。"
          }
        }
      }
    },
