    "산과 나무, 물결을 그려 넣은 지도로 바꿔 볼 수 있어요. 걸은 자리에는 숲 사이로 오솔길이 트여요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Můžeš přepnout na mapu s nakreslenými horami, stromy a vlnami. Kudy jsi chodil, tam se lesem otevřou pěšiny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan skifte til et kort tegnet med bjerge, træer og vand. Hvor du har gået, åbner der sig en sti gennem skoven."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wechsle zu einer Karte mit Bergen, Bäumen und Wasser. Wo du gegangen bist, öffnen sich Pfade durch den Wald."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μπορείτε να αλλάξετε σε χάρτη με ζωγραφισμένα βουνά, δέντρα και νερά. Όπου περπατήσατε, ανοίγουν μονοπάτια μέσα στο δάσος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switch to a map drawn with mountains, trees and water. Where you've walked, trails open up through the forest."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switch to a map drawn with mountains, trees and water. Where you've walked, trails open up through the forest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia a un mapa dibujado con montañas, árboles y olas. Donde caminaste se abre un sendero entre el bosque."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit vaihtaa karttaan, johon on piirretty vuoria, puita ja vettä. Kulkemiisi paikkoihin aukeaa polku metsän läpi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passez à une carte dessinée de montagnes, d’arbres et de vagues. Là où vous avez marché, un sentier s’ouvre entre les arbres."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu bisa beralih ke peta bergambar gunung, pohon, dan air. Di tempat yang kamu lalui, jalan setapak terbuka di antara hutan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passa a una mappa disegnata con montagne, alberi e onde. Dove hai camminato si apre un sentiero tra gli alberi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "山や木、水の流れを描き込んだ地図に切り替えられます。歩いた場所には、森の間に小道が開けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "산과 나무, 물결을 그려 넣은 지도로 바꿔 볼 수 있어요. 걸은 자리에는 숲 사이로 오솔길이 트여요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan bytte til et kart tegnet med fjell, trær og vann. Der du har gått, åpner det seg en sti gjennom skogen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies een kaart met getekende bergen, bomen en water. Waar je liep, ontstaan paadjes door het bos."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz przełączyć się na mapę z narysowanymi górami, drzewami i falami. Tam, gdzie chodziłeś, przez las prowadzą ścieżki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mude para um mapa desenhado com montanhas, árvores e ondas. Onde você andou, trilhas se abrem pela floresta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можно переключиться на карту с нарисованными горами, деревьями и волнами. Там, где вы ходили, сквозь лес пролегают тропинки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Byt till en karta med ritade berg, träd och vatten. Där du gått öppnar sig stigar genom skogen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปลี่ยนเป็นแผนที่ที่วาดภูเขา ต้นไม้ และสายน้ำลงไปได้ ที่ที่คุณเดินจะมีทางเดินเล็กๆ เปิดขึ้นท่ามกลางป่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dağlar, ağaçlar ve dalgalar çizilmiş bir haritaya geçebilirsin. Yürüdüğün yerlerde ormanın içinden patikalar açılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thể đổi sang bản đồ vẽ núi, cây và sóng nước. Ở nơi bạn đã đi, lối mòn sẽ mở ra giữa rừng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以换成画有山、树和水波的地图。走过的地方，会在林间开出小径。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以換成畫有山、樹和水波的地圖。走過的地方，會在林間開出小徑。"
          }
        }
      }
    },
