    "그쪽으로는 %@까지 걸어 보셨습니다. 오늘 더 나가 보시겠어요?" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tímto směrem jsi došel do vzdálenosti %@. Zkusíš dnes dál?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I den retning har du gået op til %@. Vil du gå længere i dag?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In diese Richtung bist du bis %@ gegangen. Heute noch ein Stück weiter?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προς τα εκεί έχετε περπατήσει έως %@. Θα πάτε λίγο πιο μακριά σήμερα;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You've walked as far as %@ in that direction. Go a little farther today?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You've walked as far as %@ in that direction. Go a little further today?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En esa dirección has llegado hasta %@. ¿Te animas a ir más lejos hoy?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siihen suuntaan olet kävellyt %@ asti. Lähtisitkö tänään pidemmälle?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans cette direction, vous êtes allé jusqu’à %@. Envie d’aller plus loin aujourd’hui ?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ke arah itu kamu sudah berjalan sejauh %@. Mau melangkah lebih jauh hari ini?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In quella direzione sei arrivato fino a %@. Oggi ti spingi più in là?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その方面には%@まで歩いています。今日はもう少し先まで行ってみませんか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그쪽으로는 %@까지 걸어 보셨습니다. 오늘 더 나가 보시겠어요?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I den retningen har du gått opptil %@. Vil du gå lenger i dag?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In die richting ben je tot %@ gekomen. Vandaag wat verder gaan?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W tę stronę doszedłeś już na %@. Pójdziesz dziś dalej?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessa direção você já foi até %@. Que tal ir mais longe hoje?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В эту сторону вы уже доходили до %@. Пройдёте сегодня дальше?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åt det hållet har du gått upp till %@. Vill du gå längre i dag?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทางนั้นคุณเคยเดินไปไกลถึง %@ วันนี้ลองออกไปไกลกว่านั้นไหม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O yönde %@ uzağa kadar yürüdün. Bugün biraz daha ileri gitmeye ne dersin?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Theo hướng đó bạn đã đi tới %@. Hôm nay đi xa hơn nhé?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个方向你最远走到%@。今天要不要再走远一点？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個方向你最遠走到%@。今天要不要再走遠一點？"
          }
        }
      }
    },
    "그쪽으로는 아직 한 걸음도 나가 보지 않으셨어요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tímto směrem jsi ještě neudělal ani krok."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I den retning har du endnu ikke taget et eneste skridt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In diese Richtung hast du noch keinen Schritt gemacht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προς τα εκεί δεν έχετε κάνει ακόμα ούτε ένα βήμα."
