    "집·일터처럼 기준이 될 만한 것으로 골라 주세요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "집·일터처럼 기준이 될 만한 것으로 골라 주세요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick something that can serve as a reference, like home or work."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick something that can serve as a reference, like home or work."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自宅や職場など、基準になりそうな場所を選んでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请选择家、公司这类可以作为基准的地方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請選擇家、公司這類可以作為基準的地方。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige algo que sirva de referencia, como casa o trabajo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle etwas als Bezugspunkt, zum Beispiel Zuhause oder Arbeit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un repère possible, comme la maison ou le travail."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli qualcosa che faccia da riferimento, come casa o lavoro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha algo que sirva de referência, como casa ou trabalho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите что-нибудь, что может служить ориентиром, например дом или работу."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกสิ่งที่เป็นจุดอ้างอิงได้ เช่น บ้านหรือที่ทำงาน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy chọn một nơi có thể làm mốc, như nhà hay chỗ làm."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyber něco, co poslouží jako orientační bod, třeba domov nebo práci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg noget, der kan fungere som holdepunkt, fx hjem eller arbejde."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαλέξτε κάτι που μπορεί να λειτουργήσει ως σημείο αναφοράς, όπως το σπίτι ή η δουλειά."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse jokin, mikä kelpaa vertailupisteeksi, esim. koti tai työ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih sesuatu yang bisa jadi acuan, seperti rumah atau kantor."
          }
        }
      }
