    "개척 나침반, 그려지는 것 보기, 오늘의 발자취를 설정의 '모아 보기'에서 열 수 있어요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompas průkopníka, Sledovat kreslení a Dnešní stopy otevřeš v Nastavení v části „Zobrazit vše“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pionerkompas, Se det blive tegnet og Dagens fodspor kan åbnes under „Se alt samlet“ i Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pionierkompass, „Zusehen, wie es gezeichnet wird“ und „Heutige Fußspuren“ öffnest du in den Einstellungen unter „Alles im Überblick“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Την Πυξίδα πρωτοπόρου, το «Δείτε πώς σχεδιάζεται» και τα Σημερινά αποτυπώματα μπορείτε να τα ανοίξετε από την «Προβολή όλων μαζί» στις Ρυθμίσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Pioneer Compass, Watch It Being Drawn and Today's Footprints from \"Browse\" in Settings."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Pioneer Compass, Watch It Being Drawn and Today's Footprints from \"Browse\" in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Brújula de pioneros, Ver cómo se dibuja y Huellas de hoy desde «Ver todo junto» en Ajustes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pioneerin kompassin, piirtymisen katselun ja Päivän jalanjäljet voi avata Asetusten kohdasta ”Näytä kaikki yhdessä”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez la Boussole des pionniers, Voir comment elle se dessine et Empreintes du jour depuis « Tout voir » dans les Réglages."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompas Perintis, Lihat Cara Digambar, dan Jejak Kaki Hari Ini bisa dibuka dari \"Lihat Semua Sekaligus\" di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri Bussola dei pionieri, Guarda come si disegna e Impronte di oggi da «Vedi tutto insieme» nelle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開拓コンパス、描かれる様子を見る、今日の足あとは、設定の「まとめて見る」から開けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개척 나침반, 그려지는 것 보기, 오늘의 발자취를 설정의 '모아 보기'에서 열 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pionerkompass, Se hvordan det tegnes og Dagens fotspor kan åpnes under «Se alt samlet» i Innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pionierskompas, Zien hoe het getekend wordt en Voetafdrukken van vandaag open je via ‘Alles samen bekijken’ in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompas pioniera, „Zobacz, jak powstaje” i „Dzisiejsze ślady” otworzysz w sekcji „Pokaż wszystko razem” w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra a Bússola dos pioneiros, Ver sendo desenhado e Pegadas de hoje em «Ver tudo junto», nos Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Компас первопроходца», «Смотреть, как рисуется» и «Следы сегодня» открываются из раздела «Смотреть всё вместе» в настройках."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pionjärkompass, Se hur den ritas och Dagens fotspår kan öppnas under ”Visa allt samlat” i Inställningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดเข็มทิศนักบุกเบิก ดูการวาด และรอยเท้าวันนี้ได้จาก \"ดูรวม\" ในการตั้งค่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öncü Pusulası, Çizilişini Gör ve Bugünün Ayak İzleri'ni Ayarlar'daki “Hepsini Birlikte Gör” bölümünden açabilirsin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thể mở La bàn tiên phong, Xem cách được vẽ và Dấu chân hôm nay từ \"Xem gộp\" trong Cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开拓罗盘、查看绘制过程和今日足迹，都可以在设置的“汇总查看”中打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開拓羅盤、查看繪製過程和今日足跡，都可以在設定的「彙整檢視」中開啟。"
          }
        }
      }
    },
    "개척 나침반. 둘레의 %lld퍼센트를 밟으셨고, %@쪽이 가장 얕습니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompas průkopníka. Prošel jsi %lld procent okolí, nejméně prošlý je směr %@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pionerkompas. Du har gået %lld procent af området, og mindst i retning %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pionierkompass. Du hast %lld Prozent der Umgebung betreten, im Bereich %@ warst du am wenigsten unterwegs."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πυξίδα πρωτοπόρου. Έχετε περπατήσει το %lld τοις εκατό της γύρω περιοχής· λιγότερο προς τα %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pioneer Compass. You've covered %lld percent of the area around you, and %@ is the least explored."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pioneer Compass. You've covered %lld percent of the area around you, and %@ is the least explored."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brújula de pioneros. Has pisado el %lld por ciento de los alrededores; hacia el %@ es donde menos has caminado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pioneerin kompassi. Olet kulkenut %lld prosenttia ympäristöstä, ja suuntaan %@ vähiten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boussole des pionniers. Vous avez parcouru %lld pour cent des environs ; c’est direction %@ que vous avez le moins marché."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompas Perintis. Kamu sudah menjelajahi %lld persen sekitarmu, dan arah %@ paling sedikit kamu jalani."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bussola dei pionieri. Hai percorso il %lld per cento dei dintorni; verso %@ hai camminato meno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開拓コンパス。周囲の%lldパーセントを歩き、%@方面がいちばん手薄です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "개척 나침반. 둘레의 %1$lld퍼센트를 밟으셨고, %2$@쪽이 가장 얕습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pionerkompass. Du har gått %lld prosent av området, og minst i retning %@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pionierskompas. Je hebt %lld procent van de omgeving belopen; in de richting %@ ben je het minst geweest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompas pioniera. Przeszedłeś %lld%% okolicy, najmniej w kierunku: %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bússola dos pioneiros. Você percorreu %lld%% dos arredores; na direção %@ você caminhou menos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Компас первопроходца. Вы прошли %lld%% окрестностей, меньше всего — в направлении: %@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pionjärkompass. Du har gått på %lld procent av omgivningen, och åt %@ har du gått minst."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เข็มทิศนักบุกเบิก คุณเดินไปแล้ว %lld เปอร์เซ็นต์ของพื้นที่รอบๆ และทิศ%@เดินน้อยที่สุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öncü Pusulası. Çevrenin yüzde %lld kadarını yürüdün; en az yürüdüğün yön %@."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La bàn tiên phong. Bạn đã đi %lld phần trăm khu vực xung quanh, hướng %@ bạn đi ít nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开拓罗盘。你已走过周围的百分之%lld，%@方向走得最少。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開拓羅盤。你已走過周圍的百分之%lld，%@方向走得最少。"
          }
        }
      }
    },
