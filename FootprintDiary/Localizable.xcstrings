    "지도에 띄워 둘 단추를 고르고, 꺼 둔 화면도 설정에서 바로 열 수 있어요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지도에 띄워 둘 단추를 고르고, 꺼 둔 화면도 설정에서 바로 열 수 있어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick which buttons float on the map, and open screens you've turned off right from Settings."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick which buttons float on the map, and open screens you've turned off right from Settings."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地図に出すボタンを選べます。オフにした画面も設定からすぐ開けます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择要浮在地图上的按钮，关闭的页面也能直接从设置里打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇要浮在地圖上的按鈕，關閉的畫面也能直接從設定裡開啟。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige qué botones flotan sobre el mapa y abre desde Ajustes las pantallas que hayas desactivado."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, welche Knöpfe auf der Karte schweben, und öffne ausgeschaltete Bildschirme direkt in den Einstellungen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez les boutons qui flottent sur la carte et ouvrez directement depuis les Réglages les écrans désactivés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli quali pulsanti far comparire sulla mappa e apri dalle Impostazioni le schermate disattivate."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha quais botões flutuam no mapa e abra direto nos Ajustes as telas desativadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите, какие кнопки показывать на карте; выключенные экраны можно открыть прямо из настроек."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกปุ่มที่จะลอยบนแผนที่ และเปิดหน้าจอที่ปิดไว้ได้ทันทีจากการตั้งค่า"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn nút nổi trên bản đồ, và mở màn hình đã tắt ngay từ Cài đặt."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyber tlačítka, která se mají na mapě objevit, a vypnuté obrazovky otevřeš přímo z Nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg, hvilke knapper der svæver på kortet, og åbn slåede-fra skærme direkte fra Indstillinger."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαλέξτε ποια κουμπιά επιπλέουν στον χάρτη και ανοίξτε τις απενεργοποιημένες οθόνες απευθείας από τις Ρυθμίσεις."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse, mitkä painikkeet leijuvat kartalla, ja avaa pois kytketyt näkymät suoraan Asetuksista."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih tombol yang melayang di peta, dan buka layar yang dimatikan langsung dari Pengaturan."
          }
        }
      }
    },
    "지도에 미리 찍어 둔 자리예요. 그 자리에 닿으면 다녀온 곳이 됩니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지도에 미리 찍어 둔 자리예요. 그 자리에 닿으면 다녀온 곳이 됩니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spots you stamped ahead of time. They become visited places once you arrive."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spots you stamped ahead of time. They become visited places once you arrive."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地図にあらかじめ押しておいた場所です。そこに着くと行った場所になります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是你提前在地图上盖好章的地方。走到那里后就变成去过的地方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是你事先在地圖上蓋好章的地方。走到那裡後就變成去過的地方。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lugares que sellaste de antemano en el mapa. Al llegar, pasan a ser lugares visitados."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orte, die du im Voraus auf der Karte gestempelt hast. Wenn du sie erreichst, werden sie zu besuchten Orten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lieux tamponnés à l’avance sur la carte. En y arrivant, ils deviennent des lieux visités."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luoghi timbrati in anticipo sulla mappa. Quando ci arrivi diventano luoghi visitati."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lugares carimbados com antecedência no mapa. Ao chegar, viram lugares visitados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Места, отмеченные на карте заранее. Когда вы дойдёте, они станут посещёнными."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ที่ที่ประทับไว้ล่วงหน้าบนแผนที่ เมื่อไปถึงจะกลายเป็นที่ที่ไปมาแล้ว"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nơi bạn đã đóng dấu trước trên bản đồ. Khi tới nơi, chúng sẽ thành nơi đã tới."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Místa, kam jsi razítko otiskl předem. Po příchodu se z nich stanou navštívená místa."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steder, du har stemplet på forhånd på kortet. Når du når frem, bliver de besøgte steder."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μέρη που σφραγίσατε από πριν στον χάρτη. Όταν φτάσετε, γίνονται επισκέψιμα μέρη."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etukäteen kartalle leimaamiasi paikkoja. Kun saavut, niistä tulee käytyjä paikkoja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempat yang kamu cap lebih dulu di peta. Saat kamu tiba, jadi tempat yang dikunjungi."
          }
        }
      }
    },
