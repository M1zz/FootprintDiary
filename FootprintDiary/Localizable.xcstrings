    "어느 쪽이든 받은 위치는 모두 저장합니다. 정확도가 낮은 점은 지도에 그리지 않을 뿐이에요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어느 쪽이든 받은 위치는 모두 저장합니다. 정확도가 낮은 점은 지도에 그리지 않을 뿐이에요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Either way, every location received is saved. Low-accuracy points just aren't drawn on the map."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Either way, every location received is saved. Low-accuracy points just aren't drawn on the map."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どちらを選んでも、受け取った位置情報はすべて保存します。精度の低いポイントを地図に描かないだけです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无论选哪一种，收到的位置都会全部保存。只是精度较低的点位不会绘制到地图上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無論選哪一種，收到的位置都會全部儲存。只是精準度較低的點位不會繪製到地圖上。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En cualquier caso, se guardan todas las ubicaciones recibidas. Solo que los puntos poco precisos no se dibujan en el mapa."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So oder so werden alle empfangenen Standorte gespeichert. Nur Punkte mit geringer Genauigkeit werden nicht auf der Karte gezeichnet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans les deux cas, toutes les positions reçues sont enregistrées. Seuls les points peu précis ne sont pas dessinés sur la carte."
          }
        }
      }
    },
    "어떤 화면이 쓰이는지 익명으로만 셉니다. 걸은 자리와 일기 글은 보내지 않아요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어떤 화면이 쓰이는지 익명으로만 셉니다. 걸은 자리와 일기 글은 보내지 않아요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We only count which screens are used, anonymously. Where you walked and your diary entries are never sent."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We only count which screens are used, anonymously. Where you walked and your diary entries are never sent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どの画面が使われたかを匿名で数えるだけです。歩いた場所や日記の文章は送信しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅以匿名方式统计哪些页面被使用。不会发送你走过的地点和日记内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅以匿名方式統計哪些畫面被使用。不會傳送你走過的地點和日記內容。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se cuentan, de forma anónima, las pantallas que se usan. No se envían los lugares que caminas ni el texto de tu diario."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird nur anonym gezählt, welche Bildschirme genutzt werden. Wo du gegangen bist und was du ins Tagebuch schreibst, wird nicht gesendet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls les écrans utilisés sont comptés, de façon anonyme. Les lieux où vous marchez et le texte de votre journal ne sont pas envoyés."
          }
        }
      }
    },
