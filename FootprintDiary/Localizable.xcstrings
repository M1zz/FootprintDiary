    "iOS가 '멈췄다'고 보고 껐어요. 되살리기를 시도했습니다" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ho označil za „pozastavený“ a vypnul. Zkusili jsme ho znovu spustit"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS mente, at du stod stille, og slog opdateringer fra. Vi prøvede at genstarte dem"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS hat es als „angehalten“ gewertet und abgeschaltet. Ein Neustart wurde versucht"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το iOS το σταμάτησε ως «σε παύση». Έγινε προσπάθεια επανεκκίνησης"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS judged it \"stopped\" and turned it off. A restart was attempted"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS judged it \"stopped\" and turned it off. A restart was attempted"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS lo detuvo por considerar que estabas parado. Se intentó reactivarlo"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS katsoi sinun pysähtyneen ja keskeytti päivitykset. Yritimme käynnistää ne uudelleen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS a jugé que vous étiez à l’arrêt et l’a coupé. Une relance a été tentée"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS menganggapnya \"berhenti\" lalu mematikannya. Sudah dicoba dihidupkan lagi"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS lo ha sospeso pensando che fossi fermo. Si è tentato di riattivarlo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOSが「停止中」と判断してオフにしました。再開を試みました"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS가 '멈췄다'고 보고 껐어요. 되살리기를 시도했습니다"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS mente at du sto stille, og slo av oppdateringer. Vi prøvde å starte dem igjen"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS heeft de updates gepauzeerd. We hebben geprobeerd ze te hervatten"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS uznał, że się zatrzymałeś, i wyłączył aktualizacje. Próbowaliśmy je wznowić"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iOS achou que você parou e desligou as atualizações. Tentamos reativá-las"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS решила, что вы остановились, и отключила обновления. Мы попытались их возобновить"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS pausade uppdateringarna. Vi försökte starta dem igen"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS เห็นว่า \"หยุดนิ่ง\" จึงปิดไป ได้ลองเปิดกลับมาแล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS “duraklatıldı” bildirip kapattı. Yeniden başlatma denendi"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS coi là \"đã dừng\" nên đã tắt. Đã thử khôi phục lại"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 判定为“已停止”并关闭了更新。已尝试恢复"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 判定為「已停止」並關閉了更新。已嘗試恢復"
          }
        }
      }
    },
