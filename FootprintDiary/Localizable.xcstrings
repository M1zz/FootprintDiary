          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lugares que sellaste de antemano en el mapa. Al llegar, pasan a ser lugares visitados."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
