    "나침반은 선 자리를 한가운데 두고 둘레를 읽습니다.\n하늘이 보이는 곳에서 잠깐만 기다려 주세요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompas dá místo, kde stojíš, doprostřed a přečte okolí.\nChvíli počkej někde, odkud je vidět obloha."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompasset læser området omkring det sted, du står.\nVent et øjeblik et sted med frit udsyn til himlen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kompass setzt deinen Standort in die Mitte und liest die Umgebung.\nWarte kurz an einem Ort mit freiem Blick zum Himmel."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η πυξίδα βάζει το σημείο όπου βρίσκεστε στο κέντρο και διαβάζει τη γύρω περιοχή.\nΠεριμένετε λίγο σε σημείο με θέα στον ουρανό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The compass puts where you're standing at the center and reads the area around it.\nPlease wait a moment somewhere with a clear view of the sky."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The compass puts where you're standing at the centre and reads the area around it.\nPlease wait a moment somewhere with a clear view of the sky."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La brújula lee los alrededores con tu posición en el centro.\nEspera un momento en un lugar a cielo abierto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompassi lukee ympäristöä nykyisen sijaintisi ympäriltä.\nOdota hetki paikassa, josta näkyy taivas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La boussole lit les environs en vous plaçant au centre.\nPatientez un instant dans un endroit à ciel ouvert."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompas membaca sekeliling dengan tempatmu berdiri sebagai pusatnya.\nTunggu sebentar di tempat yang terlihat langit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La bussola legge i dintorni mettendoti al centro.\nAspetta un attimo in un punto all’aperto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンパスは今いる場所を中心に周囲を読み取ります。\n空が見える場所で少しお待ちください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나침반은 선 자리를 한가운데 두고 둘레를 읽습니다.\n하늘이 보이는 곳에서 잠깐만 기다려 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompasset leser området rundt stedet du står.\nVent litt på et sted med fri sikt mot himmelen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het kompas leest de omgeving met jouw plek in het midden.\nWacht even op een plek met open lucht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompas odczytuje okolicę, stawiając Cię w środku.\nPoczekaj chwilę w miejscu z widokiem na niebo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bússola lê os arredores com você no centro.\nEspere um pouco em um lugar com céu aberto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Компас изучает окрестности, ставя вас в центр.\nПодождите немного там, где видно небо."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompassen läser omgivningen med platsen där du står i mitten.\nVänta en stund där du ser himlen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เข็มทิศจะอ่านพื้นที่รอบๆ โดยมีจุดที่คุณยืนอยู่เป็นศูนย์กลาง\nโปรดรอสักครู่ในที่ที่มองเห็นท้องฟ้า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pusula, durduğun yeri merkeze alıp çevreyi okur.\nGökyüzünü gören bir yerde biraz bekle."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La bàn đọc khu vực xung quanh với chỗ bạn đứng ở chính giữa.\nHãy đợi một chút ở nơi nhìn thấy bầu trời."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "罗盘会以你所在的位置为中心读取周围情况。\n请在能看到天空的地方稍等一下。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "羅盤會以你所在的位置為中心讀取周圍情況。\n請在看得到天空的地方稍等一下。"
          }
        }
      }
    },
