    "앱이 꺼져 있어도 위치가 크게 바뀌면 되살아나 이어서 기록해요" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I když je aplikace vypnutá, při velké změně polohy se probudí a pokračuje"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selv når appen er lukket, vågner den og fortsætter med at registrere, når din position ændrer sig meget"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch wenn die App geschlossen ist, startet sie bei großen Ortswechseln neu und zeichnet weiter auf"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ακόμα κι αν η εφαρμογή είναι κλειστή, ξαναξεκινά και συνεχίζει όταν η τοποθεσία αλλάξει πολύ"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even when the app is closed, it wakes up and keeps recording when your location changes a lot"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even when the app is closed, it wakes up and keeps recording when your location changes a lot"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aunque la app esté cerrada, se reactiva cuando tu ubicación cambia mucho y sigue registrando"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaikka appi on suljettu, se herää ja jatkaa tallennusta, kun sijaintisi muuttuu selvästi"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Même fermée, l’app se relance quand votre position change beaucoup et reprend l’enregistrement"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meski aplikasi tertutup, saat lokasi berubah jauh aplikasi aktif lagi dan lanjut mencatat"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche con l’app chiusa, si riattiva quando la posizione cambia molto e continua a registrare"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリが終了していても、位置が大きく変わると再起動して記録を続けます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 꺼져 있어도 위치가 크게 바뀌면 되살아나 이어서 기록해요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selv når appen er lukket, våkner den og fortsetter å registrere når posisjonen din endrer seg mye"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ook als de app gesloten is, wordt hij bij grotere verplaatsingen wakker en registreert hij verder"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nawet gdy aplikacja jest zamknięta, wznawia zapis po wyraźnej zmianie lokalizacji"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesmo com o app fechado, volta a registrar quando sua localização muda bastante"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Даже если приложение закрыто, оно оживает при заметной смене места и продолжает запись"
