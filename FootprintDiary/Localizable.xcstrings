    "새로 닿은 자리 %lld곳이 지나는 길에 찍힙니다" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nově dosažená místa (%lld) se otisknou na trase"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld nyligt nåede steder stemples på den vej, du gik"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld neu erreichte Orte werden auf den Weg gestempelt"
