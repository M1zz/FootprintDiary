        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะ **ตราประทับ** ที่มุมซ้ายล่าง เพื่อเก็บจุดที่คุณยืนอยู่ตอนนี้"
          }
        },
        "tr" : {
