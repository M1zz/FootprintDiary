            "value" : "Bạn chưa từng tới đây. Nơi này sẽ giữ ở mục \"Muốn tới\" và thành nơi đã tới khi bạn đến."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ještě jsi tu nebyl. Zůstane jako „Chci navštívit“ a po příchodu se z něj stane navštívené místo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har ikke været her endnu. Det bliver stående som „Vil besøge“ og bliver et besøgt sted, når du når frem."
