          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заблокируйте приложение с помощью Face ID или Touch ID, чтобы защитить свои маршруты и дневник."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ล็อกแอปด้วย Face ID หรือ Touch ID เพื่อปกป้องที่ที่คุณเดินและไดอารี่"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khóa ứng dụng bằng Face ID hoặc Touch ID để bảo vệ nơi bạn đã đi và nhật ký."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamkni aplikaci pomocí Face ID nebo Touch ID a ochraň, kudy jsi chodil, i svůj deník."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lås appen med Face ID eller Touch ID for at beskytte, hvor du har gået, og din dagbog."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κλειδώστε την εφαρμογή με Face ID ή Touch ID για να προστατεύσετε τα μέρη που πήγατε και το ημερολόγιό σας."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
