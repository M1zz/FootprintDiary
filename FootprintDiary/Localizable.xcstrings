    "현재 위치를 찾는 중이에요. 위치를 켜고 이 자리 근처에 오면 남길 수 있습니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hledám aktuální polohu. Zapni polohu a až budeš poblíž, můžeš to zaznamenat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder din position. Med lokalitet slået til kan du gemme, når du er i nærheden af stedet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Standort wird gesucht. Schalte den Standort ein und komm in die Nähe dieses Ortes, um den Besuch festzuhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναζητείται η τρέχουσα τοποθεσία. Ενεργοποιήστε την τοποθεσία και, όταν βρεθείτε κοντά, θα μπορείτε να το καταγράψετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finding your current location. Turn on Location and come near this spot to log a visit."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finding your current location. Turn on Location and come near this spot to log a visit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buscando tu ubicación. Activa la ubicación y acércate a este lugar para guardarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etsitään sijaintiasi. Kun sijainti on päällä ja olet lähellä tätä paikkaa, voit merkitä käynnin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherche de votre position. Activez la localisation et approchez-vous de ce lieu pour l’enregistrer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sedang mencari lokasimu. Nyalakan lokasi dan dekati tempat ini untuk mencatat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sto cercando la tua posizione. Attiva la posizione e avvicinati a questo luogo per registrarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在地を探しています。位置情報をオンにしてこの場所の近くに来ると、残せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 위치를 찾는 중이에요. 위치를 켜고 이 자리 근처에 오면 남길 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finner posisjonen din. Med posisjon slått på kan du lagre når du er i nærheten av stedet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je huidige locatie wordt gezocht. Zet locatie aan en kom in de buurt van deze plek om vast te leggen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szukam Twojej lokalizacji. Włącz lokalizację — zapiszesz wizytę, gdy będziesz w pobliżu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procurando sua localização. Com a localização ativada, você pode registrar ao chegar perto deste lugar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ищем ваше местоположение. Включите геопозицию — отметить можно, когда окажетесь рядом."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Söker din nuvarande position. Slå på platstjänster och kom nära den här platsen för att spara."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กำลังหาตำแหน่งปัจจุบัน เปิดตำแหน่งแล้วเข้าใกล้ที่นี่จะบันทึกได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şu anki konumun aranıyor. Konumu açıp bu yerin yakınına gelince kaydedebilirsin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đang tìm vị trí hiện tại. Bật vị trí và tới gần nơi này để ghi lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
