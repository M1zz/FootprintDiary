            "value" : "Simpan jalan yang kamu lalui dan catatan harian ke berkas lalu muat kembali nanti."
          }
        }
      }
    },
    "고른 기간에 걸은 길과 그 기간에 찍은 도장만 지도에 남습니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고른 기간에 걸은 길과 그 기간에 찍은 도장만 지도에 남습니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only paths walked and stamps placed during the chosen period stay on the map."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only paths walked and stamps placed during the chosen period stay on the map."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選んだ期間に歩いた道と、その期間に押したスタンプだけが地図に残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有所选时间段内走过的路和盖下的图章会留在地图上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有所選期間內走過的路和蓋下的印章會留在地圖上。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el mapa solo quedan los caminos recorridos y los sellos puestos en el periodo elegido."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf der Karte bleiben nur die im gewählten Zeitraum gegangenen Wege und gesetzten Stempel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls les chemins parcourus et les tampons posés pendant la période choisie restent sur la carte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sulla mappa restano solo i percorsi fatti e i timbri messi nel periodo scelto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No mapa ficam só os caminhos percorridos e os carimbos colocados no período escolhido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На карте остаются только пройденные пути и штампы за выбранный период."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บนแผนที่จะเหลือเฉพาะเส้นทางที่เดินและตราประทับที่ประทับในช่วงเวลาที่เลือก"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ những con đường đã đi và con dấu đã đóng trong khoảng thời gian đã chọn mới được giữ lại trên bản đồ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na mapě zůstanou jen cesty, které jsi v tomto období prošel, a razítka, která jsi v něm otiskl."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På kortet bliver kun de veje, du har gået, og de stempler, du har sat i den valgte periode."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στον χάρτη μένουν μόνο οι δρόμοι που περπατήσατε και οι σφραγίδες που βάλατε στην επιλεγμένη περίοδο."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karttaan jäävät vain valitun jakson aikana kävellyt tiet ja asetetut leimat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya jalan yang dilalui dan stempel yang dibubuhkan pada periode terpilih yang tersisa di peta."
          }
        }
      }
    },
