            "value" : "In die richting heb je nog geen stap gezet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W tę stronę nie zrobiłeś jeszcze ani kroku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você ainda não deu nenhum passo nessa direção."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В эту сторону вы ещё не сделали ни шагу."
          }
        },
        "sv" : {
          "stringUnit" : {
