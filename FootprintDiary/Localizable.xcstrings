    "아직 가보지 않은 자리예요. ‘가볼 곳’으로 남고, 그 자리에 닿으면 다녀온 곳이 됩니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 가보지 않은 자리예요. ‘가볼 곳’으로 남고, 그 자리에 닿으면 다녀온 곳이 됩니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You haven't been here yet. It stays as a \"Want to Visit\" spot and becomes a visited place once you arrive."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You haven't been here yet. It stays as a \"Want to Visit\" spot and becomes a visited place once you arrive."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ行ったことのない場所です。「行きたい場所」として残り、そこに着くと行った場所になります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是你还没去过的地方。它会作为“想去的地方”保留，走到那里后就变成去过的地方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是你還沒去過的地方。它會作為「想去的地方」保留，走到那裡後就變成去過的地方。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no has estado aquí. Quedará como «Para visitar» y pasará a ser un lugar visitado cuando llegues."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du warst noch nicht hier. Der Ort bleibt als „Möchte ich besuchen“ erhalten und wird zum besuchten Ort, sobald du ihn erreichst."
          }
        },
        "fr" : {
          "stringUnit" : {
