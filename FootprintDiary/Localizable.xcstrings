        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You haven't taken a single step that way yet."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You haven't taken a single step that way yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no has dado ni un paso en esa dirección."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siihen suuntaan et ole vielä ottanut askeltakaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n’avez encore fait aucun pas dans cette direction."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ke arah itu kamu belum melangkah sama sekali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
