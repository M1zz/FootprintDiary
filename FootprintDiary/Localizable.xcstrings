        }
      }
    },
    "지도에 미리 찍어 둔 자리예요. 그 자리에 닿으면 다녀온 곳이 됩니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지도에 미리 찍어 둔 자리예요. 그 자리에 닿으면 다녀온 곳이 됩니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spots you stamped ahead of time. They become visited places once you arrive."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spots you stamped ahead of time. They become visited places once you arrive."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地図にあらかじめ押しておいた場所です。そこに着くと行った場所になります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是你提前在地图上盖好章的地方。走到那里后就变成去过的地方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
