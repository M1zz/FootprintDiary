    "글자 크기를 키워도 잘리지 않고 보기 좋게 다시 배치돼요." : {
      "comment" : "Roadmap item detail: layouts for larger text",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screens rearrange neatly instead of getting cut off when you enlarge text."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "글자 크기를 키워도 잘리지 않고 보기 좋게 다시 배치돼요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screens rearrange neatly instead of getting cut off when you enlarge text."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字サイズを大きくしても、切れずに見やすく配置し直されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使放大字体，页面也不会被截断，而是重新排布得清清楚楚。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使放大字級，畫面也不會被截斷，而是重新排版得清清楚楚。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al agrandar el texto, las pantallas se reorganizan sin cortarse y se ven bien."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch bei größerer Schrift werden Bildschirme sauber neu angeordnet, statt abgeschnitten zu werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Même avec un texte plus grand, les écrans se réorganisent proprement au lieu d’être coupés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche con il testo più grande, le schermate si riorganizzano bene invece di tagliarsi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesmo com texto maior, as telas se reorganizam direitinho, sem cortar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Даже при увеличенном шрифте экраны аккуратно перестраиваются, а не обрезаются."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แม้ขยายขนาดตัวอักษร หน้าจอก็ไม่ถูกตัด แต่จัดวางใหม่ให้ดูสบายตา"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dù phóng to chữ, màn hình cũng không bị cắt mà được sắp xếp lại gọn gàng."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I při větším písmu se obrazovky přehledně uspořádají, místo aby se oříznuly."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selv med større tekst bliver skærmene ordnet pænt i stedet for at blive skåret af."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ακόμα και με μεγαλύτερο κείμενο, οι οθόνες αναδιατάσσονται σωστά αντί να κόβονται."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaikka suurennat tekstiä, näkymät järjestyvät siististi uudelleen eivätkä leikkaudu."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meski teks diperbesar, layar tersusun ulang rapi dan tidak terpotong."
          }
        }
      }
    },
