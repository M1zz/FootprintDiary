        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika tiba dengan berjalan kaki, kamu bisa mengambil foto di tempat"
          }
        }
      }
    },
    "걸었는데 지도에 선이 그어지지 않으면 여기서 까닭을 볼 수 있어요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "걸었는데 지도에 선이 그어지지 않으면 여기서 까닭을 볼 수 있어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you walked but no line was drawn on the map, you can find out why here."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you walked but no line was drawn on the map, you can find out why here."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歩いたのに地図に線が引かれないときは、ここで理由を確認できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
