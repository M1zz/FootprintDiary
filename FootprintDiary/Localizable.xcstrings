        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกเส้นทางที่เดินและไดอารี่เป็นไฟล์ แล้วนำกลับมาใช้ภายหลังได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu đường đã đi và nhật ký thành tệp rồi nạp lại sau."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
