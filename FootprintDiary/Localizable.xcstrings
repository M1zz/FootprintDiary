            "state" : "translated",
            "value" : "หากเดินแล้วแต่แผนที่ไม่มีเส้นปรากฏ ดูสาเหตุได้ที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yürüdün ama haritada çizgi çizilmediyse nedenini buradan görebilirsin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu bạn đã đi bộ mà bản đồ không có đường nào, bạn có thể xem lý do ở đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
