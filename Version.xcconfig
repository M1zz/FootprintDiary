// Version.xcconfig
//
// 벅뚜벅뚜의 버전과 빌드번호가 사는 단 한 곳.
//
// 여태까지는 project.pbxproj 안에 있었다. 그런데 타겟이 둘(앱·위젯)이고 설정이
// Debug·Release로 갈려, 같은 값이 네 군데에 흩어져 있었다. 배포할 때 그중 하나만
// 올라가면 앱과 위젯의 버전이 어긋난 채로 아카이브가 만들어지는데, 그건 업로드하고
// 나서야 드러난다. 그래서 네 군데에서 걷어 내고 여기 한 줄씩만 남겼다.
//
// 두 타겟은 이 파일을 프로젝트 수준에서 함께 물려받는다. 타겟 빌드 설정에 같은 이름의
// 값을 다시 적으면 그쪽이 이기고 이 파일은 아무 일도 하지 않게 되므로, 적지 말 것.
// (Xcode에서 타겟 > General의 Version·Build 칸을 고치면 바로 그 일이 벌어진다.
//  버전은 이 파일에서 고치거나 DeployBar가 고치게 두면 된다)
//
// DeployBar가 배포할 때 아래 두 줄을 통째로 갈아 쓴다. 줄 끝에 주석을 붙이면 함께
// 지워지므로 붙이지 말 것.

MARKETING_VERSION = 1.0.4
CURRENT_PROJECT_VERSION = 4
